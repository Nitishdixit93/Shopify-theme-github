{"sections":{"perito_aboutus_intro_Cdkcjg":{"type":"perito-aboutus-intro","name":"About Us Intro","settings":{"hero_image":"shopify:\/\/shop_images\/Rectangle_1_3.png","heading":"About Perito Moreno","subheading":"An artisan perfume house redefining luxury fragrance through Indian craftsmanship and contemporary artistry.","body_text":"<p>Our mission is to create world-class perfumes that celebrate India's rich olfactory heritage while pushing the boundaries of modern fragrance artistry.<\/p>","hero_height":330,"text_width":680,"body_padding_top":58,"body_padding_bottom":70,"paragraph_gap":24,"heading_size":44,"subheading_size":17,"body_font_size":17,"body_line_height":1.8,"mobile_hero_height":300,"mobile_heading_size":34,"mobile_body_padding_top":42,"mobile_body_padding_bottom":48,"body_bg":"#283416","text_color":"#efe9d8","heading_color":"#f4efe4","subheading_color":"#d9d2c4","overlay_color":"#000000","overlay_opacity":55}},"perito_aboutus_values_ppwYKd":{"type":"perito-aboutus-values","blocks":{"value_item_1_dHprHU":{"type":"value_item_1","settings":{"title":"Excellence","text":"We refuse to compromise on quality…"}},"value_item_2_kgjU9M":{"type":"value_item_2","settings":{"title":"Sustainability","text":"Ethical sourcing, fair compensation…"}},"value_item_3_kLMbGJ":{"type":"value_item_3","settings":{"title":"Community","text":"We work directly with distillers…"}},"value_item_4_kDiKfY":{"type":"value_item_4","settings":{"title":"Innovation","text":"While respecting tradition, we embrace modern techniques…"}}},"block_order":["value_item_1_dHprHU","value_item_2_kgjU9M","value_item_3_kLMbGJ","value_item_4_kDiKfY"],"name":"About Values","settings":{"section_title":"Our Values","bg_color":"#5e6b36","text_color":"#ffffff","padding_top":64,"padding_bottom":64,"padding_sides":16,"heading_size":44,"heading_margin_bottom":48,"grid_gap":48,"icon_size":56,"icon_text_gap":16,"title_size":18,"text_size":15,"text_gap":12}},"perito_about_team_pVPpVT":{"type":"perito-about-team","blocks":{"team_member_PJpKrG":{"type":"team_member","settings":{"photo":"shopify:\/\/shop_images\/Image_Founder.png","name":"Arjun Mehta","role":"Founder & Creative Director","bio":"With over 15 years working in perfumery & Greater Well-ness, Arjun founded Perito Mora to bridge India’s rich olfactory tradition with contemporary luxury botanicals."}},"team_member_AWzg8H":{"type":"team_member","settings":{"photo":"shopify:\/\/shop_images\/Image_Perfumer.png","name":"Priya Desai","role":"Master Perfumer","bio":"Trained at ISIPCA Paris, Priya brings classical French technique to indigenous Indian materials, creating compositions of rare sophistication and depth."}},"team_member_fbPPwe":{"type":"team_member","settings":{"photo":"shopify:\/\/shop_images\/Image_Sourcing_Director.png","name":"Vikram Singh","role":"Botanical Sourcing Director","bio":"Vikram builds direct trade relationships with growers, distillers, and cooperatives to source the finest raw materials."}},"team_member_8ptz68":{"type":"team_member","settings":{"photo":"shopify:\/\/shop_images\/Image_Brand_Director.png","name":"Meera Kapoor","role":"Brand & Experience Director","bio":"Meera shapes every touchpoint of the Perito Mora experience, from packaging design to retail environments and customer storytelling."}}},"block_order":["team_member_PJpKrG","team_member_AWzg8H","team_member_fbPPwe","team_member_8ptz68"],"name":"Team Section","settings":{"section_title":"The People Behind the Scent","bg_color":"#283416","text_color":"#ffffff","padding_top":72,"padding_bottom":96,"padding_sides":24,"container_width":720,"heading_size":34,"heading_margin_bottom":44,"column_gap":38,"row_gap":44,"image_height":520,"mobile_image_height":360,"image_text_gap":14,"name_size":20,"role_size":12,"role_gap":7,"bio_size":12,"bio_gap":10,"bio_line_height":145}},"peirto_about_steps_B989Un":{"type":"peirto-about-steps","blocks":{"step_d6p4LL":{"type":"step","settings":{"step_title":"Inspiration & Research","step_text":"Every fragrance begins with a question or an image—an emotion, a memory of jasmine at dawn, the smoke of temple incense. We research materials, study traditional methods, and build a creative brief."}},"step_bRGiPg":{"type":"step","settings":{"step_title":"Material Sourcing","step_text":"We source ingredients specifically for each composition. This might mean waiting for harvest season, visiting new distilleries, or importing rare molecules that perfectly capture a specific facet."}},"step_3z7DeD":{"type":"step","settings":{"step_title":"Formula Development","step_text":"Multiple trials are composed and tested over weeks or months. We evaluate longevity, projection, development, and emotional resonance. Formulas are refined until they meet our standards."}},"step_7thmtq":{"type":"step","settings":{"step_title":"Maturation & Bottling","step_text":"The final formula is produced in small batches, matured to allow the components to marry, then filtered and hand-bottled. Each bottle is individually inspected before shipment."}}},"block_order":["step_d6p4LL","step_bRGiPg","step_3z7DeD","step_7thmtq"],"name":"How We Create","settings":{"section_title":"How We Create","section_description":"From concept to bottle, every fragrance undergoes a rigorous creative and technical process","bg_color":"#5e6b36","text_color":"#ffffff","description_color":"#d8dec4","step_text_color":"#e1e5d2","line_color":"#263514","section_max_width":1500,"steps_max_width":900,"description_max_width":760,"padding_top":80,"padding_bottom":100,"padding_sides":24,"header_margin_bottom":68,"heading_size":44,"heading_weight":500,"heading_letter_spacing":0,"heading_margin_bottom":32,"description_size":18,"description_weight":300,"description_line_height":"1.6","step_gap":52,"line_width":5,"line_height":122,"line_margin_top":0,"line_text_gap":44,"number_gap":8,"step_title_size":28,"step_title_weight":600,"step_title_margin_bottom":10,"step_text_size":18,"step_text_weight":300,"step_text_line_height":"1.7","mobile_padd