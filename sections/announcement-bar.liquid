<style>
  .perito-announcement {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
    position: relative;
    z-index: 20;
  }

  .perito-announcement__inner {
    max-width: {% if section.settings.full_width %}100%{% else %}{{ settings.page_width | default: 1400 }}px{% endif %};
    margin: 0 auto;
    padding: {{ section.settings.padding_y }}px 20px;
    text-align: center;
  }

  .perito-announcement__text {
    margin: 0;
    font-size: {{ section.settings.font_size }}px;
    line-height: 1.4;
    letter-spacing: {{ section.settings.letter_spacing }}em;
    text-transform: uppercase;
    opacity: 0.95;
  }

  .perito-announcement__text a {
    color: inherit;
    text-decoration: none;
  }

  .perito-announcement__text a:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .perito-announcement__inner {
      padding-left: 14px;
      padding-right: 14px;
    }

    .perito-announcement__text {
      font-size: calc({{ section.settings.font_size }}px - 1px);
      letter-spacing: calc({{ section.settings.letter_spacing }}em * 0.8);
    }
  }
</style>

{% if section.settings.text != blank %}
  <div class="perito-announcement">
    <div class="perito-announcement__inner">
      <p class="perito-announcement__text">
        {% if section.settings.link != blank %}
          <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
        {% else %}
          {{ section.settings.text }}
        {% endif %}
      </p>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Perito Announcement Bar",
  "tag": "section",
  "class": "section-perito-announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "ORIGINAL COMPOSITIONS • SMALL BATCH CRAFTED • COLLECTOR-LED RELEASES"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement link"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#2b3319"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ebe7d8"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bottom border",
      "default": "#6d755a"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Top/bottom padding",
      "min": 6,
      "max": 20,
      "step": 1,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 9,
      "max": 18,
      "step": 1,
      "default": 11,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 0.4,
      "step": 0.1,
      "default": 0.2
    }
  ],
  "presets": [
    {
      "name": "Perito Announcement Bar"
    }
  ]
}
{% endschema %}