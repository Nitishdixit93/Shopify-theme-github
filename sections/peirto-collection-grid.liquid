{% style %}
  .perito-collections-grid {
    background: {{ section.settings.section_bg }};
    color: {{ section.settings.text_color }};
  }

  .perito-collections-grid__inner {
    padding-top: calc(var(--perito-section-space-top) + {{ section.settings.padding_top }}px);
    padding-bottom: calc(var(--perito-section-space-bottom) + {{ section.settings.padding_bottom }}px);
  }

  .perito-collections-grid__intro {
    max-width: {{ section.settings.intro_max_width }}px;
    margin: 0 auto {{ section.settings.intro_margin_bottom }}px;
    text-align: center;
  }

  .perito-collections-grid__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_margin_bottom }}px;
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_font_size }}px;
    line-height: {{ section.settings.eyebrow_line_height }};
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}em;
    text-transform: uppercase;
    font-weight: {{ section.settings.eyebrow_font_weight }};
    opacity: 0.9;
  }

  .perito-collections-grid__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size }}px;
    line-height: {{ section.settings.heading_line_height }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}em;
    font-weight: {{ section.settings.heading_font_weight }};
  }

  .perito-collections-grid__description {
    margin: {{ section.settings.description_margin_top }}px auto 0;
    max-width: {{ section.settings.description_max_width }}px;
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_font_size }}px;
    line-height: {{ section.settings.description_line_height }};
    letter-spacing: {{ section.settings.description_letter_spacing }}em;
    font-weight: {{ section.settings.description_font_weight }};
    opacity: 0.92;
  }

  .perito-collections-grid__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    justify-content: start;
    column-gap: {{ section.settings.column_gap }}px;
    row-gap: {{ section.settings.row_gap }}px;
  }

  .perito-collections-grid__card {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .perito-collections-grid__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 0.86;
    overflow: hidden;
    background: {{ section.settings.image_bg }};
  }

  .perito-collections-grid__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
}

  .perito-collections-grid__card:hover .perito-collections-grid__image {
    transform: scale(1.02);
  }

  .perito-collections-grid__placeholder {
    width: 100%;
    height: 100%;
    background: {{ section.settings.image_bg }};
  }

  .perito-collections-grid__content {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    column-gap: 14px;
    padding-top: {{ section.settings.card_content_top }}px;
  }

  .perito-collections-grid__title {
    margin: 0;
    color: {{ section.settings.card_title_color }};
    font-size: {{ section.settings.card_title_font_size }}px;
    line-height: {{ section.settings.card_title_line_height }};
    letter-spacing: {{ section.settings.card_title_letter_spacing }}em;
    font-weight: {{ section.settings.card_title_font_weight }};
  }

  .perito-collections-grid__arrow {
    color: {{ section.settings.card_title_color }};
    font-size: {{ section.settings.arrow_size }}px;
    line-height: 1;
    transform: translateY(1px);
    opacity: 0.95;
  }

  .perito-collections-grid__text {
    grid-column: 1 / -1;
    margin-top: {{ section.settings.card_text_margin_top }}px;
  }

  .perito-collections-grid__desc {
    margin: 0;
    color: {{ section.settings.card_desc_color }};
    font-size: {{ section.settings.card_desc_font_size }}px;
    line-height: {{ section.settings.card_desc_line_height }};
    letter-spacing: {{ section.settings.card_desc_letter_spacing }}em;
    font-weight: {{ section.settings.card_desc_font_weight }};
    opacity: 0.92;
  }

  .perito-collections-grid__meta {
    margin: {{ section.settings.card_meta_margin_top }}px 0 0;
    color: {{ section.settings.card_meta_color }};
    font-size: {{ section.settings.card_meta_font_size }}px;
    line-height: {{ section.settings.card_meta_line_height }};
    letter-spacing: {{ section.settings.card_meta_letter_spacing }}em;
    text-transform: uppercase;
    font-weight: {{ section.settings.card_meta_font_weight }};
    opacity: 0.9;
  }

  @media screen and (max-width: 989px) {
    .perito-collections-grid__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .perito-collections-grid__intro {
      margin-bottom: {{ section.settings.mobile_intro_margin_bottom }}px;
    }

    .perito-collections-grid__heading {
      font-size: {{ section.settings.mobile_heading_font_size }}px;
    }

    .perito-collections-grid__description {
      font-size: {{ section.settings.mobile_description_font_size }}px;
    }

    .perito-collections-grid__grid {
      grid-template-columns: 1fr;
      column-gap: 0;
      row-gap: {{ section.settings.mobile_row_gap }}px;
    }

    .perito-collections-grid__media {
      height: auto;
      aspect-ratio: 1 / 0.86;
    }

    .perito-collections-grid__title {
      font-size: {{ section.settings.mobile_card_title_font_size }}px;
    }

    .perito-collections-grid__desc {
      font-size: {{ section.settings.mobile_card_desc_font_size }}px;
    }

    .perito-collections-grid__meta {
      font-size: {{ section.settings.mobile_card_meta_font_size }}px;
    }
  }

    /* Mobile overflow fix */
  .section-perito-collections-grid,
  .perito-collections-grid,
  .perito-collections-grid * {
    box-sizing: border-box;
  }

  .section-perito-collections-grid,
  .perito-collections-grid {
    max-width: 100%;
    overflow-x: clip;
  }

  .perito-collections-grid__inner,
  .perito-collections-grid__grid,
  .perito-collections-grid__card,
  .perito-collections-grid__media {
    min-width: 0;
    max-width: 100%;
  }

  .perito-collections-grid__image {
    display: block;
    max-width: 100%;
  }

  @media screen and (max-width: 989px) {
    .section-perito-collections-grid {
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }

    .perito-collections-grid__inner {
      width: 100%;
      max-width: 100%;
      padding-left: 16px;
      padding-right: 16px;
    }

    .perito-collections-grid__grid {
      width: 100%;
      grid-template-columns: minmax(0, 1fr);
    }

    .perito-collections-grid__card {
      width: 100%;
      overflow: hidden;
    }

    .perito-collections-grid__media {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 0.86;
    }

    .perito-collections-grid__content {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .perito-collections-grid__title,
    .perito-collections-grid__desc,
    .perito-collections-grid__meta {
      overflow-wrap: anywhere;
    }
  }
{% endstyle %}

<section class="perito-collections-grid">
  <div class="perito-collections-grid__inner perito-container perito-section-inner">
    <div class="perito-collections-grid__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="perito-collections-grid__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="perito-collections-grid__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="perito-collections-grid__description">{{ section.settings.description }}</div>
      {% endif %}
    </div>

    <div class="perito-collections-grid__grid">
      {% if collections.size > 0 %}
        {% for collection in collections %}
          {% liquid
            assign card_title = collection.title
            assign card_link = collection.url
            assign fallback_description = 'Each collection represents a different approach to the art of perfumery, from haute luxury to intimate bespoke creations.'
            assign card_description = collection.description | strip_html | strip

            if card_description == blank
              assign card_description = fallback_description
            else
              assign card_description = card_description | truncate: 140
            endif
            assign card_meta = collection.all_products_count | append: ' ITEMS'
            assign card_image = collection.image

            if card_image == blank and collection.products.first.featured_image != blank
              assign card_image = collection.products.first.featured_image
            endif
          %}

          {% capture card_sizes %}(min-width: 990px) 50vw, 100vw{% endcapture %}

          <a
            class="perito-collections-grid__card"
            href="{{ card_link }}"
          >
            <div class="perito-collections-grid__media">
              {% if card_image != blank %}
                {{
                  card_image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'perito-collections-grid__image',
                    loading: 'lazy',
                    widths: '500, 700, 900, 1100, 1400',
                    sizes: card_sizes,
                    alt: card_title
                }}
              {% else %}
                <div class="perito-collections-grid__placeholder"></div>
              {% endif %}
            </div>

            <div class="perito-collections-grid__content">
              <h3 class="perito-collections-grid__title">{{ card_title }}</h3>
              <span class="perito-collections-grid__arrow">→</span>

              <div class="perito-collections-grid__text">
                {% if card_description != blank %}
                  <p class="perito-collections-grid__desc">{{ card_description }}</p>
                {% endif %}

                <p class="perito-collections-grid__meta">{{ card_meta }}</p>
              </div>
            </div>
          </a>
        {% endfor %}

      {% else %}
        {% for block in section.blocks %}
          {% capture card_sizes %}(min-width: 990px) 50vw, 100vw{% endcapture %}

          <a
            class="perito-collections-grid__card"
            href="{{ block.settings.link | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            <div class="perito-collections-grid__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'perito-collections-grid__image',
                    loading: 'lazy',
                    widths: '500, 700, 900, 1100, 1400',
                    sizes: card_sizes,
                    alt: block.settings.title
                }}
              {% else %}
                <div class="perito-collections-grid__placeholder"></div>
              {% endif %}
            </div>

            <div class="perito-collections-grid__content">
              <h3 class="perito-collections-grid__title">{{ block.settings.title }}</h3>
              <span class="perito-collections-grid__arrow">→</span>

              <div class="perito-collections-grid__text">
                {% if block.settings.description != blank %}
                  <p class="perito-collections-grid__desc">{{ block.settings.description }}</p>
                {% endif %}

                {% if block.settings.meta != blank %}
                  <p class="perito-collections-grid__meta">{{ block.settings.meta }}</p>
                {% endif %}
              </div>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

