{% style %}
.perito-team {
  background: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_top }}px {{ section.settings.padding_sides }}px {{ section.settings.padding_bottom }}px;
}

.perito-team__inner {
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
}

.perito-team__heading {
  text-align: center;
  font-size: {{ section.settings.heading_size }}px;
  line-height: 1.2;
  font-weight: 600;
  margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
  color: {{ section.settings.text_color }};
}

.perito-team__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: {{ section.settings.column_gap }}px;
  row-gap: {{ section.settings.row_gap }}px;
}

.perito-team__item {
  text-align: left;
}

.perito-team__media {
  width: 100%;
  height: {{ section.settings.image_height }}px;
  overflow: hidden;
  margin-bottom: {{ section.settings.image_text_gap }}px;
  background: rgba(255,255,255,0.08);
}

.perito-team__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.perito-team__name {
  font-size: {{ section.settings.name_size }}px;
  line-height: 1.2;
  font-weight: 600;
  margin: 0 0 {{ section.settings.role_gap }}px;
  color: {{ section.settings.text_color }};
}

.perito-team__role {
  font-size: {{ section.settings.role_size }}px;
  line-height: 1.3;
  margin: 0 0 {{ section.settings.bio_gap }}px;
  color: {{ section.settings.text_color }};
  opacity: 0.9;
}

.perito-team__bio {
  font-size: {{ section.settings.bio_size }}px;
  line-height: {{ section.settings.bio_line_height | divided_by: 100.0 }};
  margin: 0;
  color: {{ section.settings.text_color }};
  opacity: 0.9;
}

@media screen and (max-width: 749px) {
  .perito-team__grid {
    grid-template-columns: 1fr;
  }

  .perito-team__media {
    height: {{ section.settings.mobile_image_height }}px;
  }
}
{% endstyle %}

<section class="perito-team">
  <div class="perito-team__inner">
    {% if section.settings.section_title != blank %}
      <h2 class="perito-team__heading">{{ section.settings.section_title }}</h2>
    {% endif %}

    <div class="perito-team__grid">
      {% for block in section.blocks %}
        <div class="perito-team__item" {{ block.shopify_attributes }}>
          <div class="perito-team__media">
            {% if block.settings.photo != blank %}
              {{
                block.settings.photo
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  alt: block.settings.name
              }}
            {% endif %}
          </div>

          {% if block.settings.name != blank %}
            <h3 class="perito-team__name">{{ block.settings.name }}</h3>
          {% endif %}

          {% if block.settings.role != blank %}
            <p class="perito-team__role">{{ block.settings.role }}</p>
          {% endif %}

          {% if block.settings.bio != blank %}
            <p class="perito-team__bio">{{ block.settings.bio }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Team Section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "The People Behind the Scent"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#213312"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_sides",
      "label": "Padding Sides",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container Width",
      "min": 500,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 14,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading Bottom Spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column Gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row Gap",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image Height",
      "min": 200,
      "max": 520,
      "step": 5,
      "unit": "px",
      "default": 330
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile Image Height",
      "min": 200,
      "max": 520,
      "step": 5,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "image_text_gap",
      "label": "Image To Text Gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "name_size",
      "label": "Name Size",
      "min": 8,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "role_size",
      "label": "Role Size",
      "min": 6,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "role_gap",
      "label": "Role Bottom Gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 7
    },
    {
      "type": "range",
      "id": "bio_size",
      "label": "Bio Size",
      "min": 6,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "bio_gap",
      "label": "Bio Top Gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "bio_line_height",
      "label": "Bio Line Height",
      "min": 100,
      "max": 220,
      "step": 5,
      "unit": "%",
      "default": 145
    }
  ],
  "blocks": [
    {
      "type": "team_member",
      "name": "Team Member",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Arjun Mehta"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Founder & Creative Director"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Bio",
          "default": "With over 15 years working in perfumery and wellness, Arjun founded Perito Mora to bridge India’s rich olfactory tradition with contemporary luxury botanicals."
        }
      ]
    }
  ],
  "presets": [
  {
    "name": "Team Section",
    "category": "About Page",
    "blocks": [
      {
        "type": "team_member",
        "settings": {
          "name": "Arjun Mehta",
          "role": "Founder & Creative Director",
          "bio": "With over 15 years working in perfumery & Greater Well-ness, Arjun founded Perito Mora to bridge India’s rich olfactory tradition with contemporary luxury botanicals."
        }
      },
      {
        "type": "team_member",
        "settings": {
          "name": "Priya Desai",
          "role": "Master Perfumer",
          "bio": "Trained at ISIPCA Paris, Priya brings classical French technique to indigenous Indian materials, creating compositions of rare sophistication and depth."
        }
      },
      {
        "type": "team_member",
        "settings": {
          "name": "Vikram Singh",
          "role": "Botanical Sourcing Director",
          "bio": "Vikram builds direct trade relationships with growers, distillers, and cooperatives to source the finest raw materials."
        }
      },
      {
        "type": "team_member",
        "settings": {
          "name": "Meera Kapoor",
          "role": "Brand & Experience Director",
          "bio": "Meera shapes every touchpoint of the Perito Mora experience, from packaging design to retail environments and customer storytelling."
        }
      }
    ]
  }
]
}
{% endschema %}