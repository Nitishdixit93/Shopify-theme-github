{% style %}
  .perito-story-craft {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text_color }};
  }

  .perito-story-craft__inner {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding:
      {{ section.settings.padding_top }}px
      {{ section.settings.padding_x }}px
      {{ section.settings.padding_bottom }}px;
  }

  .perito-story-craft__heading {
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
    color: {{ section.settings.heading_color }};
    text-align: center;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.1;
    font-weight: 500;
  }

  .perito-story-craft__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: {{ section.settings.column_gap }}px;
    row-gap: {{ section.settings.row_gap }}px;
  }

  .perito-story-craft__item-title {
    margin: 0 0 {{ section.settings.item_title_margin_bottom }}px;
    color: {{ section.settings.item_title_color }};
    font-size: {{ section.settings.item_title_size }}px;
    line-height: 1.25;
    font-weight: 500;
  }

  .perito-story-craft__item-text {
    margin: 0;
    color: {{ section.settings.item_text_color }};
    font-size: {{ section.settings.item_text_size }}px;
    line-height: {{ section.settings.item_text_line_height }};
    font-weight: 300;
  }

  @media screen and (max-width: 749px) {
    .perito-story-craft__inner {
      padding:
        {{ section.settings.mobile_padding_top }}px
        {{ section.settings.mobile_padding_x }}px
        {{ section.settings.mobile_padding_bottom }}px;
    }

    .perito-story-craft__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      margin-bottom: {{ section.settings.mobile_heading_margin_bottom }}px;
    }

    .perito-story-craft__grid {
      grid-template-columns: 1fr;
      row-gap: {{ section.settings.mobile_row_gap }}px;
    }
  }
{% endstyle %}

<section class="perito-story-craft">
  <div class="perito-story-craft__inner">
    {% if section.settings.heading != blank %}
      <h2 class="perito-story-craft__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="perito-story-craft__grid">
      {% for block in section.blocks %}
        <div class="perito-story-craft__item" {{ block.shopify_attributes }}>
          {% if block.settings.title != blank %}
            <h3 class="perito-story-craft__item-title">{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="perito-story-craft__item-text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Perito Story Craft",
  "tag": "section",
  "class": "section-perito-story-craft",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Craft"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 720,
      "max": 1160,
      "step": 20,
      "default": 900,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 48,
      "max": 180,
      "step": 4,
      "default": 104,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 48,
      "max": 180,
      "step": 4,
      "default": 116,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Side padding",
      "min": 16,
      "max": 80,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading bottom spacing",
      "min": 30,
      "max": 90,
      "step": 2,
      "default": 62,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 40,
      "max": 140,
      "step": 4,
      "default": 104,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 40,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 58,
      "step": 1,
      "default": 38,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_title_size",
      "label": "Item title size",
      "min": 14,
      "max": 28,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_title_margin_bottom",
      "label": "Item title bottom spacing",
      "min": 8,
      "max": 30,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_text_size",
      "label": "Item text size",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_text_line_height",
      "label": "Item text line height",
      "min": 1.3,
      "max": 2.3,
      "step": 0.1,
      "default": 1.8
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 40,
      "max": 120,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 40,
      "max": 120,
      "step": 2,
      "default": 70,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_x",
      "label": "Mobile side padding",
      "min": 16,
      "max": 40,
      "step": 2,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 26,
      "max": 46,
      "step": 1,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_heading_margin_bottom",
      "label": "Mobile heading bottom spacing",
      "min": 24,
      "max": 70,
      "step": 2,
      "default": 42,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_row_gap",
      "label": "Mobile item gap",
      "min": 28,
      "max": 70,
      "step": 2,
      "default": 42,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#273315"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base text",
      "default": "#efe9d8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#f4efe4"
    },
    {
      "type": "color",
      "id": "item_title_color",
      "label": "Item title",
      "default": "#f4efe4"
    },
    {
      "type": "color",
      "id": "item_text_color",
      "label": "Item text",
      "default": "#d6d0bf"
    }
  ],
  "blocks": [
    {
      "type": "craft_item",
      "name": "Craft item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Sourcing"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "From the attar distilleries of Kannauj to jasmine farms in Tamil Nadu, we build direct relationships with material suppliers. This ensures quality, traceability, and fair compensation for growers and distillers."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perito Story Craft",
      "blocks": [
        {
          "type": "craft_item",
          "settings": {
            "title": "Sourcing",
            "text": "From the attar distilleries of Kannauj to jasmine farms in Tamil Nadu, we build direct relationships with material suppliers. This ensures quality, traceability, and fair compensation for growers and distillers."
          }
        },
        {
          "type": "craft_item",
          "settings": {
            "title": "Composition",
            "text": "Our perfumer balances naturals with modern molecules, creating compositions that have both soul and stability. Development cycles can take months—we don't rush the process."
          }
        },
        {
          "type": "craft_item",
          "settings": {
            "title": "Production",
            "text": "Every batch is small, hand-blended, and matured before bottling. We favor quality over scale, which means some fragrances sell out and may not return."
          }
        },
        {
          "type": "craft_item",
          "settings": {
            "title": "Presentation",
            "text": "Our bottles and packaging reflect the care that goes into the liquid. Minimalist, refined, and designed to age gracefully on your shelf."
          }
        }
      ]
    }
  ]
}
{% endschema %}