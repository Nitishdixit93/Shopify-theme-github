          <p class="perito-discovery__text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank %}
      <a class="perito-discovery__button" href="{{ section.settings.button_link | default: '#' }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Perito Discovery Program",
  "tag": "section",
  "class": "section-perito-discovery",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DISCOVERY PROGRAM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Begin Your Scent Journey"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Not sure where to start? Our sample program allows you to explore our collections before committing to a full bottle."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "EXPLORE SAMPLE SETS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 180,
      "step": 2,
      "default": 102,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 180,
      "step": 2,
      "default": 112,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "intro_width",
      "label": "Intro width",
      "min": 520,
      "max": 1100,
      "step": 20,
      "default": 920,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "intro_margin_bottom",
      "label": "Intro bottom margin",
      "min": 50,
      "max": 150,
      "step": 2,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Item column gap",
      "min": 40,
      "max": 180,
      "step": 2,
      "default": 92,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_margin_top",
      "label": "Button top space",
      "min": 50,
      "max": 150,
      "step": 2,
      "default": 94,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
