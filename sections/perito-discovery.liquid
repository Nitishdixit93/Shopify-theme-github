      "step": 0.1,
      "default": 0.5
    },
    {
      "type": "range",
      "id": "eyebrow_font_weight",
      "label": "Eyebrow weight",
      "min": 300,
      "max": 700,
      "step": 50,
      "default": 400
    },
    {
      "type": "range",
      "id": "eyebrow_margin_bottom",
      "label": "Eyebrow bottom margin",
      "min": 12,
      "max": 42,
