{% style %}
  .perito-discovery {
    background: {{ section.settings.section_bg }};
    color: {{ section.settings.text_color }};
  }

  .perito-discovery__inner {
    padding-top: calc(var(--perito-section-space-top) + {{ section.settings.padding_top }}px);
    padding-bottom: calc(var(--perito-section-space-bottom) + {{ section.settings.padding_bottom }}px);
    text-align: center;
  }

  .perito-discovery__intro {
    max-width: {{ section.settings.intro_width }}px;
    margin: 0 auto {{ section.settings.intro_margin_bottom }}px;
  }

  .perito-discovery__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_margin_bottom }}px;
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_font_size }}px;
    line-height: 1.2;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}em;
    text-transform: uppercase;
    font-weight: {{ section.settings.eyebrow_font_weight }};
  }

  .perito-discovery__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size }}px;
    line-height: {{ section.settings.heading_line_height }};
    font-weight: {{ section.settings.heading_font_weight }};
  }

  .perito-discovery__description {
    margin: {{ section.settings.description_margin_top }}px auto 0;
    max-width: {{ section.settings.description_width }}px;
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_font_size }}px;
    line-height: {{ section.settings.description_line_height }};
    font-weight: {{ section.settings.description_font_weight }};
  }

  .perito-discovery__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: {{ section.settings.item_gap }}px;
    margin-bottom: {{ section.settings.button_margin_top }}px;
  }

  .perito-discovery__item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .perito-discovery__icon {
    width: {{ section.settings.icon_box_size }}px;
    height: {{ section.settings.icon_box_size }}px;
    border: 1px solid {{ section.settings.icon_border }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ section.settings.icon_margin_bottom }}px;
    color: {{ section.settings.icon_color }};
  }

  .perito-discovery__icon svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
  }

  .perito-discovery__title {
    margin: 0 0 {{ section.settings.item_title_margin_bottom }}px;
    color: {{ section.settings.item_title_color }};
    font-size: {{ section.settings.item_title_size }}px;
    line-height: 1.25;
    font-weight: {{ section.settings.item_title_weight }};
  }

  .perito-discovery__text {
    margin: 0;
    max-width: {{ section.settings.item_text_width }}px;
    color: {{ section.settings.item_text_color }};
    font-size: {{ section.settings.item_text_size }}px;
    line-height: {{ section.settings.item_text_line_height }};
    font-weight: {{ section.settings.item_text_weight }};
  }

  .perito-discovery__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.button_width }}px;
    height: {{ section.settings.button_height }}px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text }};
    border: 1px solid {{ section.settings.button_border }};
    text-decoration: none;
    text-transform: uppercase;
    font-size: {{ section.settings.button_font_size }}px;
    letter-spacing: {{ section.settings.button_letter_spacing }}em;
    font-weight: {{ section.settings.button_font_weight }};
  }

  @media screen and (max-width: 989px) {
    .perito-discovery__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .perito-discovery__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    .perito-discovery__description {
      font-size: {{ section.settings.mobile_description_size }}px;
    }

    .perito-discovery__items {
      grid-template-columns: 1fr;
      row-gap: {{ section.settings.mobile_item_gap }}px;
    }

    .perito-discovery__button {
      width: 100%;
    }
  }
{% endstyle %}

<section class="perito-discovery">
  <div class="perito-discovery__inner perito-container perito-section-inner">
    <div class="perito-discovery__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="perito-discovery__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="perito-discovery__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="perito-discovery__description">{{ section.settings.description }}</div>
      {% endif %}
    </div>

    <div class="perito-discovery__items">
      {% for block in section.blocks %}
