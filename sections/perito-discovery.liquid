                  <path d="M14 9.33301V24.4997" stroke="currentColor" stroke-width="2.33333" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M22.1663 14V22.1667C22.1663 22.7855 21.9205 23.379 21.4829 23.8166C21.0453 24.2542 20.4518 24.5 19.833 24.5H8.16634C7.5475 24.5 6.95401 24.2542 6.51643 23.8166C6.07884 23.379 5.83301 22.7855 5.83301 22.1667V14" stroke="currentColor" stroke-width="2.33333" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M8.74967 9.33287C7.97613 9.33287 7.23426 9.02558 6.68728 8.47859C6.1403 7.93161 5.83301 7.18975 5.83301 6.4162C5.83301 5.64265 6.1403 4.90079 6.68728 4.35381C7.23426 3.80682 7.97613 3.49953 8.74967 3.49953C9.87514 3.47992 10.978 4.026 11.9145 5.06655C12.851 6.10711 13.5777 7.59384 13.9997 9.33287C14.4217 7.59384 15.1483 6.10711 16.0848 5.06655C17.0213 4.026 18.1242 3.47992 19.2497 3.49953C20.0232 3.49953 20.7651 3.80682 21.3121 4.35381C21.859 4.90079 22.1663 5.64265 22.1663 6.4162C22.1663 7.18975 21.859 7.93161 21.3121 8.47859C20.7651 9.02558 20.0232 9.33287 19.2497 9.33287" stroke="currentColor" stroke-width="2.33333" stroke-linecap="round" stroke-linejoin="round"/>
