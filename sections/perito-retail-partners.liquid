{% style %}
.perito-retail-partners-{{ section.id }} {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__hero {
  position: relative;
  min-height: {{ section.settings.hero_height }}px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: {{ section.settings.hero_padding_top }}px {{ section.settings.padding_sides }}px {{ section.settings.hero_padding_bottom }}px;
  overflow: hidden;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__hero-image {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  background-color: {{ section.settings.hero_overlay_color }};
  opacity: {{ section.settings.hero_overlay_opacity | divided_by: 100.0 }};
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__hero-content {
  position: relative;
  z-index: 3;
  max-width: {{ section.settings.hero_content_width }}px;
  margin: 0 auto;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__hero-heading {
  color: {{ section.settings.hero_heading_color }};
  font-size: {{ section.settings.hero_heading_size }}px;
  font-weight: {{ section.settings.hero_heading_weight }};
  line-height: 1.15;
  margin: 0 0 {{ section.settings.hero_heading_margin_bottom }}px;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__hero-text {
  color: {{ section.settings.hero_text_color }};
  font-size: {{ section.settings.hero_text_size }}px;
  font-weight: {{ section.settings.hero_text_weight }};
  line-height: {{ section.settings.hero_text_line_height }};
  max-width: {{ section.settings.hero_text_width }}px;
  margin: 0 auto;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__main {
  padding: {{ section.settings.main_padding_top }}px {{ section.settings.padding_sides }}px {{ section.settings.main_padding_bottom }}px;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__intro {
  max-width: {{ section.settings.intro_width }}px;
  margin: 0 auto {{ section.settings.intro_margin_bottom }}px;
  text-align: center;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__intro-text {
  color: {{ section.settings.intro_text_color }};
  font-size: {{ section.settings.intro_text_size }}px;
  font-weight: {{ section.settings.intro_text_weight }};
  line-height: {{ section.settings.intro_text_line_height }};
  margin: 0;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__countries {
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__country {
  margin-bottom: {{ section.settings.country_gap }}px;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__country:last-child {
  margin-bottom: 0;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__country-heading {
  color: {{ section.settings.country_heading_color }};
  font-size: {{ section.settings.country_heading_size }}px;
  font-weight: {{ section.settings.country_heading_weight }};
  line-height: 1.2;
  margin: 0 0 {{ section.settings.country_heading_margin_bottom }}px;
  padding-bottom: {{ section.settings.country_line_spacing }}px;
  border-bottom: {{ section.settings.country_line_width }}px solid {{ section.settings.country_line_color }};
  white-space: nowrap;
  word-break: keep-all;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: {{ section.settings.card_gap }}px;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__card {
  border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
  background-color: {{ section.settings.card_bg_color }};
  min-height: {{ section.settings.card_min_height }}px;
  padding: {{ section.settings.card_padding_top }}px {{ section.settings.card_padding_sides }}px {{ section.settings.card_padding_bottom }}px;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__store-name {
  color: {{ section.settings.store_name_color }};
  font-size: {{ section.settings.store_name_size }}px;
  font-weight: {{ section.settings.store_name_weight }};
  line-height: 1.3;
  margin: 0 0 {{ section.settings.store_name_margin_bottom }}px;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__info {
  display: flex;
  align-items: flex-start;
  gap: {{ section.settings.icon_gap }}px;
  color: {{ section.settings.info_text_color }};
  font-size: {{ section.settings.info_text_size }}px;
  font-weight: {{ section.settings.info_text_weight }};
  line-height: {{ section.settings.info_text_line_height }};
  margin: 0 0 {{ section.settings.info_gap }}px;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__info:last-child {
  margin-bottom: 0;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__icon {
  width: {{ section.settings.icon_size }}px;
  height: {{ section.settings.icon_size }}px;
  flex: 0 0 {{ section.settings.icon_size }}px;
  margin-top: {{ section.settings.icon_top_spacing }}px;
  display: inline-flex;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__icon svg {
  width: 100%;
  height: 100%;
  display: block;
}

.perito-retail-partners-{{ section.id }} .perito-retail-partners__divider {
  height: {{ section.settings.card_divider_width }}px;
  background-color: {{ section.settings.card_divider_color }};
  margin: {{ section.settings.card_divider_spacing }}px 0;
}

@media screen and (max-width: 749px) {
  .perito-retail-partners-{{ section.id }} .perito-retail-partners__hero {
    min-height: {{ section.settings.mobile_hero_height }}px;
    padding: {{ section.settings.mobile_hero_padding_top }}px {{ section.settings.mobile_padding_sides }}px {{ section.settings.mobile_hero_padding_bottom }}px;
  }

  .perito-retail-partners-{{ section.id }} .perito-retail-partners__hero-heading {
    font-size: {{ section.settings.mobile_hero_heading_size }}px;
  }

  .perito-retail-partners-{{ section.id }} .perito-retail-partners__hero-text {
    font-size: {{ section.settings.mobile_hero_text_size }}px;
  }

  .perito-retail-partners-{{ section.id }} .perito-retail-partners__main {
    padding: {{ section.settings.mobile_main_padding_top }}px {{ section.settings.mobile_padding_sides }}px {{ section.settings.mobile_main_padding_bottom }}px;
  }

  .perito-retail-partners-{{ section.id }} .perito-retail-partners__intro {
    margin-bottom: {{ section.settings.mobile_intro_margin_bottom }}px;
  }

  .perito-retail-partners-{{ section.id }} .perito-retail-partners__grid {
    grid-template-columns: 1fr;
    gap: {{ section.settings.mobile_card_gap }}px;
  }

  .perito-retail-partners-{{ section.id }} .perito-retail-partners__country-heading {
    font-size: {{ section.settings.mobile_country_heading_size }}px;
    white-space: nowrap;
  }

  .perito-retail-partners-{{ section.id }} .perito-retail-partners__card {
    min-height: {{ section.settings.mobile_card_min_height }}px;
    padding: {{ section.settings.mobile_card_padding_top }}px {{ section.settings.mobile_card_padding_sides }}px {{ section.settings.mobile_card_padding_bottom }}px;
  }
}
{% endstyle %}

<section class="perito-retail-partners-{{ section.id }}">
  {% if section.settings.show_hero %}
    <div class="perito-retail-partners__hero">
      {% if section.settings.hero_image != blank %}
        <div class="perito-retail-partners__hero-image">
          {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager' }}
        </div>
      {% endif %}

      <div class="perito-retail-partners__hero-overlay"></div>

      <div class="perito-retail-partners__hero-content">
        {% if section.settings.hero_heading != blank %}
          <h1 class="perito-retail-partners__hero-heading">
            {{ section.settings.hero_heading }}
          </h1>
        {% endif %}

        {% if section.settings.hero_text != blank %}
          <p class="perito-retail-partners__hero-text">
            {{ section.settings.hero_text }}
          </p>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="perito-retail-partners__main">
    {% if section.settings.intro_text != blank %}
      <div class="perito-retail-partners__intro">
        <p class="perito-retail-partners__intro-text">
          {{ section.settings.intro_text }}
        </p>
      </div>
    {% endif %}

    <div class="perito-retail-partners__countries">
      {% for block in section.blocks %}
        <div class="perito-retail-partners__country" {{ block.shopify_attributes }}>
          {% if block.settings.country_name != blank %}
            <h2 class="perito-retail-partners__country-heading">
              {{ block.settings.country_name }}
            </h2>
          {% endif %}

          <div class="perito-retail-partners__grid">
            {% for i in (1..6) %}
              {% liquid
                assign store_name_key = 'store_' | append: i | append: '_name'
                assign address_key = 'store_' | append: i | append: '_address'
                assign phone_key = 'store_' | append: i | append: '_phone'
                assign email_key = 'store_' | append: i | append: '_email'
                assign link_key = 'store_' | append: i | append: '_link_label'
                assign url_key = 'store_' | append: i | append: '_link_url'

                assign store_name = block.settings[store_name_key]
                assign address = block.settings[address_key]
                assign phone = block.settings[phone_key]
                assign email = block.settings[email_key]
                assign link_label = block.settings[link_key]
                assign link_url = block.settings[url_key]
              %}

              {% if store_name != blank %}
                <div class="perito-retail-partners__card">
                  <h3 class="perito-retail-partners__store-name">
                    {{ store_name }}
                  </h3>

                  {% if address != blank %}
                    <p class="perito-retail-partners__info">
                      <span class="perito-retail-partners__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                          <path d="M13.3346 6.66659C13.3346 9.99525 9.64197 13.4619 8.40197 14.5326C8.28645 14.6194 8.14583 14.6664 8.0013 14.6664C7.85677 14.6664 7.71615 14.6194 7.60064 14.5326C6.36064 13.4619 2.66797 9.99525 2.66797 6.66659C2.66797 5.2521 3.22987 3.89554 4.23007 2.89535C5.23026 1.89516 6.58681 1.33325 8.0013 1.33325C9.41579 1.33325 10.7723 1.89516 11.7725 2.89535C12.7727 3.89554 13.3346 5.2521 13.3346 6.66659Z" stroke="white" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M8 8.66675C9.10457 8.66675 10 7.77132 10 6.66675C10 5.56218 9.10457 4.66675 8 4.66675C6.89543 4.66675 6 5.56218 6 6.66675C6 7.77132 6.89543 8.66675 8 8.66675Z" stroke="white" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                      <span>{{ address }}</span>
                    </p>
                  {% endif %}

                  {% if phone != blank or email != blank or link_label != blank %}
                    <div class="perito-retail-partners__divider"></div>
                  {% endif %}

                  {% if phone != blank %}
                    <p class="perito-retail-partners__info">
                      <span class="perito-retail-partners__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                          <g clip-path="url(#clip0_phone_{{ section.id }}_{{ block.id }}_{{ i }})">
                            <path d="M14.665 11.28V13.28C14.6657 13.4657 14.6277 13.6494 14.5533 13.8195C14.479 13.9897 14.3699 14.1424 14.233 14.2679C14.0962 14.3934 13.9347 14.489 13.7588 14.5485C13.5829 14.6079 13.3966 14.63 13.2117 14.6133C11.1602 14.3904 9.18966 13.6894 7.45833 12.5667C5.84755 11.5431 4.48189 10.1774 3.45833 8.56665C2.33165 6.82745 1.63049 4.84731 1.41166 2.78665C1.395 2.60229 1.41691 2.41649 1.47599 2.24107C1.53508 2.06564 1.63004 1.90444 1.75484 1.76773C1.87964 1.63102 2.03153 1.52179 2.20086 1.447C2.37018 1.37221 2.55322 1.33349 2.73833 1.33332H4.73833C5.06187 1.33013 5.37552 1.4447 5.62084 1.65567C5.86615 1.86664 6.02638 2.15961 6.07166 2.47998C6.15608 3.12003 6.31263 3.74847 6.53833 4.35332C6.62802 4.59193 6.64744 4.85126 6.59427 5.10057C6.5411 5.34988 6.41757 5.57872 6.23833 5.75998L5.39166 6.60665C6.3407 8.27568 7.72263 9.65761 9.39166 10.6067L10.2383 9.75998C10.4196 9.58074 10.6484 9.45722 10.8977 9.40405C11.1471 9.35088 11.4064 9.37029 11.645 9.45998C12.2498 9.68568 12.8783 9.84224 13.5183 9.92665C13.8422 9.97234 14.1379 10.1355 14.3494 10.385C14.5608 10.6345 14.6731 10.953 14.665 11.28Z" stroke="#5E6B36" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                          </g>
                          <defs>
                            <clipPath id="clip0_phone_{{ section.id }}_{{ block.id }}_{{ i }}">
                              <rect width="16" height="16" fill="white"/>
                            </clipPath>
                          </defs>
                        </svg>
                      </span>
                      <span>{{ phone }}</span>
                    </p>
                  {% endif %}

                  {% if email != blank %}
                    <p class="perito-retail-partners__info">
                      <span class="perito-retail-partners__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                          <path d="M13.332 2.66675H2.66536C1.92898 2.66675 1.33203 3.2637 1.33203 4.00008V12.0001C1.33203 12.7365 1.92898 13.3334 2.66536 13.3334H13.332C14.0684 13.3334 14.6654 12.7365 14.6654 12.0001V4.00008C14.6654 3.2637 14.0684 2.66675 13.332 2.66675Z" stroke="#5E6B36" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M14.6654 4.66675L8.68536 8.46675C8.47955 8.5957 8.24158 8.66409 7.9987 8.66409C7.75582 8.66409 7.51785 8.5957 7.31203 8.46675L1.33203 4.66675" stroke="#5E6B36" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                      <span>{{ email }}</span>
                    </p>
                  {% endif %}

                  {% if link_label != blank %}
                    <p class="perito-retail-partners__info">
                      <span class="perito-retail-partners__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                          <path d="M10 2H14V6" stroke="#5E6B36" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M6.66797 9.33333L14.0013 2" stroke="#5E6B36" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M12 8.66667V12.6667C12 13.0203 11.8595 13.3594 11.6095 13.6095C11.3594 13.8595 11.0203 14 10.6667 14H3.33333C2.97971 14 2.64057 13.8595 2.39052 13.6095C2.14048 13.3594 2 13.0203 2 12.6667V5.33333C2 4.97971 2.14048 4.64057 2.39052 4.39052C2.64057 4.14048 2.97971 4 3.33333 4H7.33333" stroke="#5E6B36" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>

                      {% if link_url != blank %}
                        <a href="{{ link_url }}" style="color: inherit; text-decoration: none;">
                          {{ link_label }}
                        </a>
                      {% else %}
                        <span>{{ link_label }}</span>
                      {% endif %}
                    </p>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Retail Partners",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show hero",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "About Perito Moreno"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Hero text",
      "default": "An artisan perfume house redefining luxury fragrance through Indian craftsmanship and contemporary artistry."
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro text",
      "default": "We partner with a curated network of independent perfumeries and luxury retailers who share our commitment to artistry, expertise, and personal service. Visit any location below to experience our collections in person."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page background color",
      "default": "#213312"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Page text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "hero_overlay_color",
      "label": "Hero overlay color",
      "default": "#000000"
    },
    {
      "type": "number",
      "id": "hero_overlay_opacity",
      "label": "Hero overlay opacity",
      "default": 62
    },
    {
      "type": "color",
      "id": "hero_heading_color",
      "label": "Hero heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "hero_text_color",
      "label": "Hero text color",
      "default": "#E6E6DE"
    },
    {
      "type": "color",
      "id": "intro_text_color",
      "label": "Intro text color",
      "default": "#D5DDC5"
    },
    {
      "type": "color",
      "id": "country_heading_color",
      "label": "Country heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "country_line_color",
      "label": "Country line color",
      "default": "#39492A"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#39492A"
    },
    {
      "type": "color",
      "id": "store_name_color",
      "label": "Store name color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "info_text_color",
      "label": "Store details color",
      "default": "#D5DDC5"
    },
    {
      "type": "color",
      "id": "card_divider_color",
      "label": "Card divider color",
      "default": "#39492A"
    },
    {
      "type": "number",
      "id": "container_width",
      "label": "Container width",
      "default": 980
    },
    {
      "type": "number",
      "id": "padding_sides",
      "label": "Side padding",
      "default": 24
    },
    {
      "type": "number",
      "id": "hero_height",
      "label": "Hero height",
      "default": 360
    },
    {
      "type": "number",
      "id": "hero_padding_top",
      "label": "Hero top padding",
      "default": 90
    },
    {
      "type": "number",
      "id": "hero_padding_bottom",
      "label": "Hero bottom padding",
      "default": 90
    },
    {
      "type": "number",
      "id": "hero_content_width",
      "label": "Hero content width",
      "default": 760
    },
    {
      "type": "number",
      "id": "hero_heading_size",
      "label": "Hero heading size",
      "default": 44
    },
    {
      "type": "number",
      "id": "hero_heading_weight",
      "label": "Hero heading weight",
      "default": 300
    },
    {
      "type": "number",
      "id": "hero_heading_margin_bottom",
      "label": "Hero heading bottom spacing",
      "default": 22
    },
    {
      "type": "number",
      "id": "hero_text_width",
      "label": "Hero text width",
      "default": 620
    },
    {
      "type": "number",
      "id": "hero_text_size",
      "label": "Hero text size",
      "default": 12
    },
    {
      "type": "number",
      "id": "hero_text_weight",
      "label": "Hero text weight",
      "default": 300
    },
    {
      "type": "text",
      "id": "hero_text_line_height",
      "label": "Hero text line height",
      "default": "1.7"
    },
    {
      "type": "number",
      "id": "main_padding_top",
      "label": "Main top padding",
      "default": 82
    },
    {
      "type": "number",
      "id": "main_padding_bottom",
      "label": "Main bottom padding",
      "default": 92
    },
    {
      "type": "number",
      "id": "intro_width",
      "label": "Intro width",
      "default": 720
    },
    {
      "type": "number",
      "id": "intro_margin_bottom",
      "label": "Intro bottom spacing",
      "default": 64
    },
    {
      "type": "number",
      "id": "intro_text_size",
      "label": "Intro text size",
      "default": 12
    },
    {
      "type": "number",
      "id": "intro_text_weight",
      "label": "Intro text weight",
      "default": 300
    },
    {
      "type": "text",
      "id": "intro_text_line_height",
      "label": "Intro text line height",
      "default": "1.8"
    },
    {
      "type": "number",
      "id": "country_gap",
      "label": "Gap between countries",
      "default": 56
    },
    {
      "type": "number",
      "id": "country_heading_size",
      "label": "Country heading size",
      "default": 24
    },
    {
      "type": "number",
      "id": "country_heading_weight",
      "label": "Country heading weight",
      "default": 600
    },
    {
