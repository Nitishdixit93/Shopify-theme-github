{% style %}
  .perito-story-cta {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text_color }};
    text-align: center;
  }

  .perito-story-cta__inner {
    max-width: 900px;
    margin: 0 auto;
    padding:
      {{ section.settings.padding_top }}px
      24px
      {{ section.settings.padding_bottom }}px;
  }

  .perito-story-cta__heading {
    margin: 0 0 18px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.15;
    font-weight: 500;
  }

  .perito-story-cta__text {
    margin: 0 auto 28px;
    max-width: 520px;
    color: {{ section.settings.body_color }};
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.7;
    font-weight: 300;
  }

  .perito-story-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: {{ section.settings.button_width }}px;
    height: {{ section.settings.button_height }}px;
    padding: 0 28px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text }};
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: {{ section.settings.button_font_size }}px;
    line-height: 1;
    font-weight: 400;
  }

  @media screen and (max-width: 749px) {
    .perito-story-cta__inner {
      padding:
        {{ section.settings.mobile_padding_top }}px
        20px
        {{ section.settings.mobile_padding_bottom }}px;
    }

    .perito-story-cta__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<section class="perito-story-cta">
  <div class="perito-story-cta__inner">
    {% if section.settings.heading != blank %}
      <h2 class="perito-story-cta__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <p class="perito-story-cta__text">{{ section.settings.text }}</p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a class="perito-story-cta__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Perito Story CTA",
  "tag": "section",
  "class": "section-perito-story-cta",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the Collection"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover fragrances that tell the story of India’s olfactory landscape"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 60,
      "max": 220,
      "step": 4,
      "default": 108,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 60,
      "max": 220,
      "step": 4,
      "default": 112,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 56,
      "step": 1,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 8,
      "max": 18,
      "step": 1,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_width",
      "label": "Button width",
      "min": 140,
      "max": 320,
      "step": 5,
      "default": 185,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Button height",
      "min": 28,
      "max": 64,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button font size",
      "min": 7,
      "max": 16,
      "step": 1,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 40,
      "max": 140,
      "step": 2,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 40,
      "max": 140,
      "step": 2,
      "default": 78,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 22,
      "max": 42,
      "step": 1,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#273315"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base text",
      "default": "#efe9d8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#f4efe4"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text",
      "default": "#d8d2c2"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#f4f1e8"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#637236"
    }
  ],
  "presets": [
    {
      "name": "Perito Story CTA"
    }
  ]
}
{% endschema %}