<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('[data-perito-product-section]');
    if (!section) return;

    const variants = [
      {% for variant in product.variants %}
        {% capture formatted_variant_price %}
          {% render 'format-price', price: variant.price %}
        {% endcapture %}
        {
          id: {{ variant.id | json }},
          title: {{ variant.title | json }},
          option1: {{ variant.option1 | json }},
          option2: {{ variant.option2 | json }},
          option3: {{ variant.option3 | json }},
          price: {{ variant.price | json }},
          formatted_price: {{ formatted_variant_price | strip | json }},
          available: {{ variant.available | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ];

    const productTitle = {{ product.title | json }};

    {% capture product_metafield_size_js %}
      {% if product.metafields.custom.size != blank %}
        {{ product.metafields.custom.size.value | default: product.metafields.custom.size }}
      {% endif %}
    {% endcapture %}

    const productMetafieldSize = {{ product_metafield_size_js | strip | json }};

    const mainImage = section.querySelector('[data-product-main-image]');
    const thumbs = section.querySelectorAll('[data-product-thumb]');
    const hiddenVariantInput = section.querySelector('[data-product-variant-id]');
    const priceEl = section.querySelector('[data-product-price]');
    const sizeEl = section.querySelector('[data-product-size]');
    const stockEl = section.querySelector('[data-product-stock]');
    const addButton = section.querySelector('[data-product-add-button]');
    const variantInputs = section.querySelectorAll('.perito-product__variant-input');
    const wishlistButton = section.querySelector('[data-product-wishlist]');

    function cleanMetafieldSize(value) {
      const size = String(value || '').trim();
      return size && size !== '0' ? size : '';
    }

    function hasSize(value) {
      return /\d+(?:\.\d+)?\s*(ml|gm|gram|grams)/i.test(value || '');
    }

    function extractSizeFromText(value) {
      const match = String(value || '').match(/(\d+(?:\.\d+)?)\s*(ml|gm|gram|grams)\b/i);
      if (!match) return '';

      const number = match[1];
      const unit = match[2].toLowerCase();

      if (unit === 'gram') return `${number} Gram`;
      if (unit === 'grams') return `${number} Grams`;

      return `${number}${unit}`;
    }

    function getVariantSize(variant) {
      const options = [variant.option1, variant.option2, variant.option3];

      for (const option of options) {
        if (option && option !== 'Default Title' && hasSize(option)) {
          return option;
        }
      }

      if (variant.title && variant.title !== 'Default Title' && hasSize(variant.title)) {
        return variant.title.split(' / ')[0];
      }

      const metafieldSize = cleanMetafieldSize(productMetafieldSize);
      if (metafieldSize) return metafieldSize;

      return extractSizeFromText(productTitle);
    }

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const fullImage = thumb.dataset.fullImage;
        const alt = thumb.dataset.alt || '';

        if (mainImage && fullImage) {
          mainImage.src = fullImage;
          mainImage.srcset = '';
          mainImage.alt = alt;
        }

        thumbs.forEach((item) => item.classList.remove('is-active'));
        thumb.classList.add('is-active');
      });
    });

    variantInputs.forEach((input) => {
      input.addEventListener('change', () => {
        const variant = variants.find((item) => String(item.id) === String(input.value));
        if (!variant) return;

        if (hiddenVariantInput) hiddenVariantInput.value = variant.id;
        if (priceEl) priceEl.innerHTML = variant.formatted_price;

        if (sizeEl) {
          const size = getVariantSize(variant);
          sizeEl.textContent = size;
          sizeEl.style.display = size ? '' : 'none';
        }

        if (stockEl) {
          stockEl.innerHTML = variant.available
            ? '<span class="perito-product__stock-dot"></span>In Stock - Ships within 2-3 days'
            : 'Out of stock';
        }

        if (addButton) {
          addButton.disabled = !variant.available;
          addButton.textContent = variant.available ? 'Add to Cart' : 'Unavailable';
        }
      });
    });

    const wishlistKey = 'peritoWishlist';

    function getWishlist() {
      try {
        return JSON.parse(localStorage.getItem(wishlistKey) || '[]');
      } catch {
        return [];
      }
    }

    function saveWishlist(list) {
      localStorage.setItem(wishlistKey, JSON.stringify(list));
    }

    function updateWishlistButton() {
      if (!wishlistButton) return;

      const handle = wishlistButton.dataset.handle;
      const list = getWishlist();
      const isActive = list.includes(handle);

      wishlistButton.classList.toggle('active', isActive);
      wishlistButton.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      wishlistButton.textContent = isActive ? '♥ Added to Wishlist' : '♡ Add to Wishlist';
    }

    if (wishlistButton) {
      updateWishlistButton();

      wishlistButton.addEventListener('click', () => {
        const handle = wishlistButton.dataset.handle;
        if (!handle) return;

        const list = getWishlist();
        const index = list.indexOf(handle);

        if (index >= 0) {
          list.splice(index, 1);
        } else {
          list.push(handle);
        }

        saveWishlist(list);
        updateWishlistButton();

        window.dispatchEvent(new CustomEvent('perito:wishlist-updated', {
          detail: { wishlist: list }
        }));
      });
    }
  });
</script>

