{% style %}
  .perito-product {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text }};
  }

  .perito-product__inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 64px {{ section.settings.padding_bottom }}px;
  }

  .perito-product__top {
    display: grid;
    grid-template-columns: 520px 520px;
    gap: 64px;
    align-items: start;
  }

  .perito-product__main-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #d9d9d9;
    overflow: hidden;
  }

  .perito-product__main-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .perito-product__thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 18px;
  }

  .perito-product__thumb {
    aspect-ratio: 1 / 1;
    background: #eee9df;
    overflow: hidden;
    border: 1px solid transparent;
    padding: 0;
    cursor: pointer;
  }

  .perito-product__thumb.is-active {
    border-color: {{ section.settings.gold }};
  }

  .perito-product__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .perito-product__badges {
    display: flex;
    gap: 6px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .perito-product__badge {
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text }};
    font-size: {{ section.settings.badge_size }}px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 12px;
  }

  .perito-product__vendor {
    margin: 0 0 8px;
    font-size: {{ section.settings.vendor_size }}px;
    line-height: 1.2;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .perito-product__title {
    margin: 0 0 12px;
    color: {{ section.settings.text }};
    font-size: {{ section.settings.title_size }}px;
    line-height: 1.05;
    font-weight: 600;
  }

  .perito-product__subtitle {
    margin: 0 0 38px;
    max-width: 430px;
    font-size: {{ section.settings.subtitle_size }}px;
    line-height: 1.55;
    opacity: 0.9;
  }

  .perito-product__divider {
    height: 1px;
    background: {{ section.settings.text }};
    opacity: 0.75;
    margin-bottom: 22px;
  }

  .perito-product__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
  }

  .perito-product__price {
    font-size: {{ section.settings.price_size }}px;
    line-height: 1;
    font-weight: 400;
  }

  .perito-product__size {
    font-size: {{ section.settings.size_size }}px;
    opacity: 0.85;
  }

  .perito-product__size-label {
    margin: 0 0 8px;
    font-size: {{ section.settings.size_label_size }}px;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: underline;
    font-weight: 600;
  }

  .perito-product__variants {
    display: flex;
    gap: 9px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .perito-product__variant-input {
    display: none;
  }

  .perito-product__variant-label {
    min-width: 68px;
    height: 38px;
    border: 1px solid {{ section.settings.text }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.text }};
    font-size: {{ section.settings.variant_size }}px;
    cursor: pointer;
    padding: 0 12px;
  }

  .perito-product__variant-input:checked + .perito-product__variant-label {
    background: {{ section.settings.text }};
    color: {{ section.settings.bg }};
  }

  .perito-product__variant-input:disabled + .perito-product__variant-label {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .perito-product__stock {
    margin: 0 0 34px;
    font-size: {{ section.settings.stock_size }}px;
    line-height: 1.4;
  }

  .perito-product__stock-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: #00d96b;
    margin-right: 8px;
  }

  .perito-product__button,
  .perito-product__wishlist {
    width: 100%;
    height: 50px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: {{ section.settings.button_size }}px;
    font-weight: 400;
  }

  .perito-product__button {
    border: 1px solid {{ section.settings.button_bg }};
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text }};
    margin-bottom: 12px;
    cursor: pointer;
  }

  .perito-product__button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .perito-product__wishlist {
    border: 1px solid {{ section.settings.text }};
    background: transparent;
    color: {{ section.settings.text }};
    cursor: pointer;
  }

  .perito-product__wishlist.active {
    background: {{ section.settings.text }};
    color: {{ section.settings.bg }};
  }

  .perito-product__notes {
    margin-top: 94px;
    text-align: center;
  }

  .perito-product__section-title {
    margin: 0 0 28px;
    font-size: {{ section.settings.section_title_size }}px;
    line-height: 1.15;
    font-weight: 600;
  }

  .perito-product__notes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 64px;
    max-width: 900px;
    margin: 0 auto;
    text-align: left;
  }

  .perito-product__note {
    font-size: {{ section.settings.note_size }}px;
    line-height: 1.9;
  }

  .perito-product__story {
    max-width: 900px;
    margin: 76px auto 0;
  }

  .perito-product__story h2 {
    margin: 0 0 24px;
    font-size: {{ section.settings.story_heading_size }}px;
    line-height: 1.15;
    font-weight: 600;
  }

  .perito-product__story-text {
    font-size: {{ section.settings.story_text_size }}px;
    line-height: 1.8;
  }

  .perito-product__story-text p {
    margin: 0 0 24px;
  }

  .perito-product__verdict {
    max-width: 900px;
    margin: 62px auto 0;
    padding: 32px 0;
    border-top: 1px solid {{ section.settings.text }};
    border-bottom: 1px solid {{ section.settings.text }};
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 24px;
  }

  .perito-product__verdict-icon svg {
    width: 48px;
    height: 48px;
    display: block;
  }

  .perito-product__verdict h3 {
    margin: 0 0 14px;
    font-size: {{ section.settings.verdict_heading_size }}px;
    line-height: 1.2;
    font-weight: 600;
  }

  .perito-product__verdict p {
    margin: 0;
    font-size: {{ section.settings.verdict_text_size }}px;
    line-height: 1.75;
  }

  .perito-product__icons {
    max-width: 900px;
    margin: 58px auto 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 42px;
    text-align: center;
  }

  .perito-product__icon {
    margin-bottom: 14px;
  }

  .perito-product__icon svg {
    width: 40px;
    height: 40px;
    display: inline-block;
  }

  .perito-product__icon-title {
    margin: 0 0 9px;
    font-size: {{ section.settings.feature_title_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .perito-product__icon-text {
    margin: 0;
    font-size: {{ section.settings.feature_text_size }}px;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .perito-product__inner {
      padding: 32px 20px 60px;
    }

    .perito-product__top {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .perito-product__badge {
      font-size: {{ section.settings.mobile_badge_size }}px;
    }

    .perito-product__vendor {
      font-size: {{ section.settings.mobile_vendor_size }}px;
    }

    .perito-product__title {
      font-size: {{ section.settings.mobile_title_size }}px;
    }

    .perito-product__subtitle {
      font-size: {{ section.settings.mobile_subtitle_size }}px;
    }

    .perito-product__price {
      font-size: {{ section.settings.mobile_price_size }}px;
    }

    .perito-product__size {
      font-size: {{ section.settings.mobile_size_size }}px;
    }

    .perito-product__size-label {
      font-size: {{ section.settings.mobile_size_label_size }}px;
    }

    .perito-product__variant-label {
      font-size: {{ section.settings.mobile_variant_size }}px;
    }

    .perito-product__stock {
      font-size: {{ section.settings.mobile_stock_size }}px;
    }

    .perito-product__button,
    .perito-product__wishlist {
      font-size: {{ section.settings.mobile_button_size }}px;
    }

    .perito-product__notes {
      margin-top: 64px;
    }

    .perito-product__section-title {
      font-size: {{ section.settings.mobile_section_title_size }}px;
    }

    .perito-product__note {
      font-size: {{ section.settings.mobile_note_size }}px;
    }

    .perito-product__notes-grid,
    .perito-product__icons {
      grid-template-columns: 1fr;
      gap: 28px;
      text-align: center;
    }

    .perito-product__story,
    .perito-product__verdict {
      margin-top: 54px;
    }

    .perito-product__story h2 {
      font-size: {{ section.settings.mobile_story_heading_size }}px;
    }

    .perito-product__story-text {
      font-size: {{ section.settings.mobile_story_text_size }}px;
    }

    .perito-product__verdict {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .perito-product__verdict-icon {
      display: flex;
      justify-content: center;
    }

    .perito-product__verdict h3 {
      font-size: {{ section.settings.mobile_verdict_heading_size }}px;
    }

    .perito-product__verdict p {
      font-size: {{ section.settings.mobile_verdict_text_size }}px;
    }

    .perito-product__icon-title {
      font-size: {{ section.settings.mobile_feature_title_size }}px;
    }

    .perito-product__icon-text {
      font-size: {{ section.settings.mobile_feature_text_size }}px;
    }
  }
{% endstyle %}

{% liquid
  assign description_text = product.description | strip_html

  assign story_text = description_text
  assign top_notes = ''
  assign middle_notes = ''
  assign base_notes = ''

  if description_text contains 'TOP NOTES'
    assign story_text = description_text | split: 'TOP NOTES' | first | strip

    assign after_top = description_text | split: 'TOP NOTES' | last
    assign top_notes = after_top | split: 'MIDDLE NOTES' | first | strip
  endif

  if description_text contains 'MIDDLE NOTES'
    assign after_middle = description_text | split: 'MIDDLE NOTES' | last
    assign middle_notes = after_middle | split: 'BASE NOTES' | first | strip
  endif

  if description_text contains 'BASE NOTES'
    assign base_notes = description_text | split: 'BASE NOTES' | last | strip
  endif

  assign top_notes_clean = top_notes | replace: ',', '<br>' | replace: '•', '<br>' | strip
  assign middle_notes_clean = middle_notes | replace: ',', '<br>' | replace: '•', '<br>' | strip
  assign base_notes_clean = base_notes | replace: ',', '<br>' | replace: '•', '<br>' | strip

  assign current_variant = product.selected_or_first_available_variant

  if current_variant == blank
    assign current_variant = product.variants.first
  endif

  assign current_product_size = ''

  assign variant_title = current_variant.title | strip
  assign variant_title_downcase = variant_title | downcase

  assign option_1 = current_variant.option1 | strip
  assign option_1_downcase = option_1 | downcase

  assign option_2 = current_variant.option2 | strip
  assign option_2_downcase = option_2 | downcase

  assign option_3 = current_variant.option3 | strip
  assign option_3_downcase = option_3 | downcase

  if option_1 != blank and option_1 != 'Default Title' and option_1_downcase contains 'ml'
    assign current_product_size = option_1
  elsif option_1 != blank and option_1 != 'Default Title' and option_1_downcase contains 'gm'
    assign current_product_size = option_1
  elsif option_1 != blank and option_1 != 'Default Title' and option_1_downcase contains 'gram'
    assign current_product_size = option_1
  elsif option_2 != blank and option_2 != 'Default Title' and option_2_downcase contains 'ml'
    assign current_product_size = option_2
  elsif option_2 != blank and option_2 != 'Default Title' and option_2_downcase contains 'gm'
    assign current_product_size = option_2
  elsif option_2 != blank and option_2 != 'Default Title' and option_2_downcase contains 'gram'
    assign current_product_size = option_2
  elsif option_3 != blank and option_3 != 'Default Title' and option_3_downcase contains 'ml'
    assign current_product_size = option_3
  elsif option_3 != blank and option_3 != 'Default Title' and option_3_downcase contains 'gm'
    assign current_product_size = option_3
  elsif option_3 != blank and option_3 != 'Default Title' and option_3_downcase contains 'gram'
    assign current_product_size = option_3
  elsif variant_title_downcase contains 'ml'
    assign current_product_size = variant_title | split: ' / ' | first
  elsif variant_title_downcase contains 'gm'
    assign current_product_size = variant_title | split: ' / ' | first
  elsif variant_title_downcase contains 'gram'
    assign current_product_size = variant_title | split: ' / ' | first
  endif

  assign metafield_size = ''

  if product.metafields.custom.size != blank
    assign metafield_size = product.metafields.custom.size.value | default: product.metafields.custom.size | strip

    if metafield_size == '0'
      assign metafield_size = ''
    endif
  endif

  if current_product_size == blank and metafield_size != blank
    assign current_product_size = metafield_size
  endif

  if current_product_size == blank
    assign title_words = product.title | replace: '-', ' ' | replace: '/', ' ' | replace: ',', ' ' | split: ' '
    assign previous_word = ''

    for word in title_words
      assign word_clean = word | strip
      assign word_downcase = word_clean | downcase

      if word_downcase == 'ml'
        if previous_word != blank
          assign current_product_size = previous_word | append: 'ml'
          break
        endif
      elsif word_downcase == 'gm'
        if previous_word != blank
          assign current_product_size = previous_word | append: 'gm'
          break
        endif
      elsif word_downcase == 'gram'
        if previous_word != blank
          assign current_product_size = previous_word | append: ' Gram'
          break
        endif
      elsif word_downcase == 'grams'
        if previous_word != blank
          assign current_product_size = previous_word | append: ' Grams'
          break
        endif
      elsif word_downcase contains 'ml'
        assign current_product_size = word_clean
        break
      elsif word_downcase contains 'gm'
        assign current_product_size = word_clean
        break
      elsif word_downcase contains 'gram'
        assign current_product_size = word_clean
        break
      endif

      assign previous_word = word_clean
    endfor
  endif
%}

<section class="perito-product" data-perito-product-section>
  <div class="perito-product__inner">
    <div class="perito-product__top">
      <div class="perito-product__gallery">
        <div class="perito-product__main-image">
          {% if product.featured_image != blank %}
            {{
              product.featured_image
              | image_url: width: 1200
              | image_tag:
                loading: 'eager',
                alt: product.title,
                data-product-main-image: ''
            }}
          {% endif %}
        </div>

        <div class="perito-product__thumbs">
          {% for media in product.media limit: 4 %}
            {% if media.preview_image != blank %}
              <button
                class="perito-product__thumb {% if forloop.first %}is-active{% endif %}"
                type="button"
                data-product-thumb
                data-full-image="{{ media.preview_image | image_url: width: 1200 }}"
                data-alt="{{ product.title | escape }}"
              >
                {{
                  media.preview_image
                  | image_url: width: 260
                  | image_tag: loading: 'lazy', alt: product.title
                }}
              </button>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="perito-product__summary">
        <div class="perito-product__badges">
          {% for tag in product.tags %}
            {% if tag contains 'badge:' %}
              <span class="perito-product__badge">
                {{ tag | remove: 'badge:' | replace: '-', ' ' | upcase }}
              </span>
            {% endif %}
          {% endfor %}
        </div>

        <p class="perito-product__vendor">
          {% if product.metafields.custom.collection_name != blank %}
            {{ product.metafields.custom.collection_name }}
          {% elsif product.collections.first != blank %}
            {{ product.collections.first.title }}
          {% else %}
            {{ product.vendor }}
          {% endif %}
        </p>

        <h1 class="perito-product__title">{{ product.title }}</h1>

        <p class="perito-product__subtitle">
          {% if product.metafields.custom.short_description != blank %}
            {{ product.metafields.custom.short_description }}
          {% elsif story_text != blank %}
            {{ story_text | truncate: 120 }}
          {% else %}
            {{ product.description | strip_html | truncate: 120 }}
          {% endif %}
        </p>

        <div class="perito-product__divider"></div>

        {% form 'product', product, class: 'perito-product__form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-variant-id>

          <div class="perito-product__price-row">
            <div class="perito-product__price" data-product-price>
              {% render 'format-price', price: current_variant.price %}
            </div>

            <span
              class="perito-product__size"
              data-product-size
              {% if current_product_size == blank %}style="display: none;"{% endif %}
            >
              {{ current_product_size }}
            </span>
          </div>

          {% unless product.has_only_default_variant %}
            <p class="perito-product__size-label">Select Size</p>

            <div class="perito-product__variants">
              {% for variant in product.variants %}
                <input
                  class="perito-product__variant-input"
                  type="radio"
                  name="variant-picker"
                  value="{{ variant.id }}"
                  id="Variant-{{ section.id }}-{{ variant.id }}"
                  data-variant-id="{{ variant.id }}"
                  {% if variant.id == current_variant.id %}checked{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                <label class="perito-product__variant-label" for="Variant-{{ section.id }}-{{ variant.id }}">
                  {{ variant.title }}
                </label>
              {% endfor %}
            </div>
          {% endunless %}

          <p class="perito-product__stock" data-product-stock>
            {% if current_variant.available %}
              <span class="perito-product__stock-dot"></span>
              In Stock - Ships within 2-3 days
            {% else %}
              Out of stock
            {% endif %}
          </p>

          <button
            class="perito-product__button"
            type="submit"
            name="add"
            data-product-add-button
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {% if current_variant.available %}
              Add to Cart
            {% else %}
              Unavailable
            {% endif %}
          </button>

          <button
            class="perito-product__wishlist"
            type="button"
            data-product-wishlist
            data-handle="{{ product.handle }}"
            aria-pressed="false"
          >
            ♡ Add to Wishlist
          </button>
        {% endform %}
      </div>
    </div>

    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'fragrance_notes' %}
          <div class="perito-product__notes" {{ block.shopify_attributes }}>
            <h2 class="perito-product__section-title">{{ block.settings.heading }}</h2>

            <div class="perito-product__notes-grid">
              <div class="perito-product__note">
                {{ top_notes_clean }}
              </div>

              <div class="perito-product__note">
                {{ middle_notes_clean }}
              </div>

              <div class="perito-product__note">
                {{ base_notes_clean }}
              </div>
            </div>
          </div>

        {% when 'story' %}
          <div class="perito-product__story" {{ block.shopify_attributes }}>
            <h2>{{ block.settings.heading }}</h2>

            <div class="perito-product__story-text">
              {% if product.metafields.custom.story != blank %}
                {{ product.metafields.custom.story | metafield_tag }}
              {% elsif story_text != blank %}
                {{ story_text | newline_to_br }}
              {% else %}
                <p>Add story text before the TOP NOTES label in your product description.</p>
              {% endif %}
            </div>
          </div>

        {% when 'perfumer_verdict' %}
          <div class="perito-product__verdict" {{ block.shopify_attributes }}>
            <div class="perito-product__verdict-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
                <path d="M30.9535 25.78L33.9835 42.832C34.0174 43.0328 33.9893 43.2392 33.9028 43.4235C33.8162 43.6079 33.6755 43.7614 33.4994 43.8636C33.3232 43.9658 33.1201 44.0118 32.9171 43.9954C32.7141 43.9791 32.521 43.9011 32.3635 43.772L25.2035 38.398C24.8579 38.1398 24.438 38.0003 24.0065 38.0003C23.575 38.0003 23.1552 38.1398 22.8095 38.398L15.6375 43.77C15.4801 43.8989 15.2872 43.9767 15.0845 43.9931C14.8818 44.0095 14.6788 43.9637 14.5028 43.8618C14.3268 43.7598 14.1861 43.6067 14.0993 43.4227C14.0126 43.2387 13.9841 43.0327 14.0175 42.832L17.0455 25.78" stroke="#C6A769" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M24 28C30.6274 28 36 22.6274 36 16C36 9.37258 30.6274 4 24 4C17.3726 4 12 9.37258 12 16C12 22.6274 17.3726 28 24 28Z" stroke="#C6A769" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            <div>
              <h3>{{ block.settings.heading }}</h3>
              <p>
                {% if product.metafields.custom.perfumer_verdict != blank %}
                  {{ product.metafields.custom.perfumer_verdict }}
                {% else %}
                  {{ block.settings.fallback_text | newline_to_br }}
                {% endif %}
              </p>
            </div>
          </div>

        {% when 'product_features' %}
          <div class="perito-product__icons" {{ block.shopify_attributes }}>
            <div>
              <div class="perito-product__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
