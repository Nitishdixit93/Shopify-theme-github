<style>
  .perito-header {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    position: relative;
    z-index: 30;
  }

  .perito-header__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: {{ section.settings.padding_y }}px 28px;
  }

  .perito-header__row {
    display: grid;
    grid-template-columns: minmax(160px, 220px) minmax(0, 1fr) auto;
    align-items: center;
    column-gap: clamp(12px, 2vw, 24px);
    min-height: {{ section.settings.header_height }}px;
  }

  .perito-header__brand {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
  }

  .perito-header__logo-link,
  .perito-header__text-logo {
    color: {{ section.settings.text_color }};
    text-decoration: none;
  }

  .perito-header__text-logo {
    display: inline-block;
    font-size: {{ section.settings.logo_font_size }}px;
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 450;
    font-style: normal;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .perito-header__logo-image {
    display: block;
    width: {{ section.settings.logo_width }}px;
    max-width: 100%;
    height: auto;
  }

  .perito-header__nav-wrap {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .perito-header__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 1.6vw, {{ section.settings.menu_gap }}px);
    flex-wrap: nowrap;
    min-width: 0;
  }

  .perito-header__nav a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    font-size: {{ section.settings.menu_font_size }}px;
    text-transform: uppercase;
    letter-spacing: {{ section.settings.menu_letter_spacing }}em;
    line-height: 1;
    font-weight: 400;
    font-style: normal;
    white-space: nowrap;
    opacity: 0.82;
    transition: opacity 0.2s ease;
  }

  .perito-header__nav a:hover {
    opacity: 1;
  }

  .perito-header__icons {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: {{ section.settings.icon_gap }}px;
  }

  .perito-header__icon-link {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    position: relative;
    opacity: 0.96;
    transition: opacity 0.2s ease;
  }

  .perito-header__icon-link:hover {
    opacity: 1;
  }

  .perito-header__icon-link svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .perito-header__cart-count {
    position: absolute;
    top: -6px;
    right: -7px;
    min-width: 14px;
    height: 14px;
    border-radius: 999px;
    background: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
    font-size: 8px;
    line-height: 14px;
    text-align: center;
    padding: 0 3px;
    font-weight: 500;
  }

  .perito-header__mobile-toggle,
  .perito-header__mobile-menu {
    display: none;
  }

  @media screen and (max-width: 1180px) {
    .perito-header__inner {
      padding: {{ section.settings.padding_y }}px 16px;
    }

    .perito-header__row {
      grid-template-columns: auto 1fr auto;
      gap: 12px;
      min-height: 46px;
    }

    .perito-header__mobile-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      background: transparent;
      border: 0;
      color: {{ section.settings.text_color }};
      padding: 0;
      cursor: pointer;
      opacity: 0.9;
    }

    .perito-header__mobile-toggle svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.6;
    }

    .perito-header__brand {
      justify-content: center;
    }

    .perito-header__text-logo {
      font-size: {{ section.settings.logo_font_size_mobile }}px;
    }

    .perito-header__logo-image {
      width: 150px;
    }

    .perito-header__nav-wrap {
      display: none;
    }

    .perito-header__icons {
      gap: 10px;
    }

    .perito-header__icon-link {
      width: 18px;
      height: 18px;
    }

    .perito-header__cart-count {
      min-width: 14px;
      height: 14px;
      line-height: 14px;
      font-size: 8px;
      top: -5px;
      right: -7px;
    }

    .perito-header__icons .hide-mobile {
      display: none;
    }

    .perito-header__mobile-menu {
      display: block;
      padding: 12px 0 6px;
    }

    .perito-header__mobile-menu[hidden] {
      display: none;
    }

    .perito-header__mobile-menu nav {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 0 2px 8px;
    }

    .perito-header__mobile-menu a {
      color: {{ section.settings.text_color }};
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: {{ section.settings.menu_letter_spacing }}em;
      font-size: 11px;
      line-height: 1.35;
      font-weight: 400;
      opacity: 0.9;
      padding: 7px 0;
    }
  }

  @media screen and (min-width: 1181px) and (max-width: 1280px) {
  .perito-header__logo-image {
    width: 180px;
  }

  .perito-header__text-logo {
    font-size: {{ section.settings.logo_font_size }}px;
  }

  .perito-header__nav a {
    font-size: 8px;
    letter-spacing: 0.14em;
  }
}
</style>

<div class="perito-header">
  <div class="perito-header__inner perito-container" >
    <div class="perito-header__row">
      <button
        class="perito-header__mobile-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="PeritoMobileMenu-{{ section.id }}"
        onclick="(function(btn){var menu=document.getElementById('PeritoMobileMenu-{{ section.id }}'); var expanded=btn.getAttribute('aria-expanded') === 'true'; btn.setAttribute('aria-expanded', expanded ? 'false' : 'true'); if(menu){menu.hidden = expanded;}})(this)"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6H21"></path>
          <path d="M3 12H21"></path>
          <path d="M3 18H21"></path>
        </svg>
      </button>

      <div class="perito-header__brand">
        {% if section.settings.logo != blank %}
          <a href="{{ routes.root_url }}" class="perito-header__logo-link" aria-label="{{ shop.name }}">
            {{
              section.settings.logo
              | image_url: width: section.settings.logo_width
              | image_tag:
                class: 'perito-header__logo-image',
                widths: '120, 180, 240, 320, 400',
                loading: 'eager',
                alt: shop.name
            }}
          </a>
        {% else %}
          <a href="{{ routes.root_url }}" class="perito-header__text-logo">
            {% if section.settings.logo_text != blank %}
              {{ section.settings.logo_text | upcase }}
            {% else %}
              {{ shop.name | upcase }}
            {% endif %}
          </a>
        {% endif %}
      </div>

      <div class="perito-header__nav-wrap">
        <nav class="perito-header__nav" aria-label="Primary">
          {% if section.settings.menu != blank %}
            {% for link in section.settings.menu.links %}
              {% if link.title == 'Past Product' and section.settings.show_past_products == false %}
                {% continue %}
              {% endif %}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {% endfor %}
          {% else %}
            <a href="/collections/all">Collection</a>
            {% if section.settings.show_past_products %}
              <a href="/collections/past-products">Past Products</a>
            {% endif %}
            <a href="/pages/bespoke">Bespoke</a>
            <a href="/pages/discovery">Discovery</a>
            <a href="/blogs/news">Journal</a>
            <a href="/pages/contact">Contact Us</a>
          {% endif %}
        </nav>
      </div>

      <div class="perito-header__icons">
        {% if section.settings.show_search %}
          <a class="perito-header__icon-link hide-mobile" href="{{ routes.search_url }}" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M9.16667 15.8333C12.8486 15.8333 15.8333 12.8486 15.8333 9.16667C15.8333 5.48477 12.8486 2.5 9.16667 2.5C5.48477 2.5 2.5 5.48477 2.5 9.16667C2.5 12.8486 5.48477 15.8333 9.16667 15.8333Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M17.5013 17.5L13.918 13.9167" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.show_wishlist and section.settings.wishlist_link != blank %}
          <a class="perito-header__icon-link hide-mobile" href="{{ section.settings.wishlist_link }}" aria-label="Wishlist">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M15.8346 11.6667C17.0763 10.45 18.3346 8.99167 18.3346 7.08333C18.3346 5.86776 17.8517 4.70197 16.9922 3.84243C16.1327 2.98289 14.9669 2.5 13.7513 2.5C12.2846 2.5 11.2513 2.91667 10.0013 4.16667C8.7513 2.91667 7.71797 2.5 6.2513 2.5C5.03573 2.5 3.86994 2.98289 3.0104 3.84243C2.15085 4.70197 1.66797 5.86776 1.66797 7.08333C1.66797 9 2.91797 10.4583 4.16797 11.6667L10.0013 17.5L15.8346 11.6667Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.show_cart %}
          <a class="perito-header__icon-link" href="{{ routes.cart_url }}" aria-label="Cart" data-cart-drawer-open>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M5 1.66669L2.5 5.00002V16.6667C2.5 17.1087 2.67559 17.5326 2.98816 17.8452C3.30072 18.1578 3.72464 18.3334 4.16667 18.3334H15.8333C16.2754 18.3334 16.6993 18.1578 17.0118 17.8452C17.3244 17.5326 17.5 17.1087 17.5 16.6667V5.00002L15 1.66669H5Z" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M2.5 5H17.5" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M13.3346 8.33331C13.3346 9.21737 12.9834 10.0652 12.3583 10.6903C11.7332 11.3155 10.8854 11.6666 10.0013 11.6666C9.11725 11.6666 8.2694 11.3155 7.64428 10.6903C7.01916 10.0652 6.66797 9.21737 6.66797 8.33331" stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="perito-header__cart-count" data-cart-count>
              {{ cart.item_count }}
            </span>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="perito-header__mobile-menu" id="PeritoMobileMenu-{{ section.id }}" hidden>
      <nav aria-label="Mobile">
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}
            {% assign link_handle = link.title | handleize %}
            {% if link_handle != 'past-products' or section.settings.show_past_products %}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {% endif %}
          {% endfor %}
        {% else %}
          <a href="/collections/all">Collection</a>
          {% if section.settings.show_past_products %}
            <a href="/collections/past-products">Past Products</a>
          {% endif %}
          <a href="/pages/bespoke">Bespoke</a>
          <a href="/pages/discovery">Discovery</a>
          <a href="/blogs/news">Journal</a>
          <a href="/pages/contact">Contact Us</a>
        {% endif %}

        {% if section.settings.show_search %}
          <a href="{{ routes.search_url }}">Search</a>
        {% endif %}

        {% if section.settings.show_wishlist and section.settings.wishlist_link != blank %}
          <a href="{{ section.settings.wishlist_link }}">Wishlist</a>
        {% endif %}

        {% if section.settings.show_cart %}
          <a href="{{ routes.cart_url }}" data-cart-drawer-open>Cart</a>
        {% endif %}
      </nav>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Perito Header",
  "tag": "section",
  "class": "section-perito-header",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "PERITO MORENO"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 320,
      "step": 10,
      "default": 210,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_font_size",
      "label": "Text logo size",
      "min": 16,
      "max": 42,
      "step": 1,
      "default": 30,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "logo_font_size_mobile",
      "label": "Text logo size - mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu"
    },
    {
      "type": "checkbox",
      "id": "show_past_products",
      "label": "Show past products",
      "default": false
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Header height",
      "min": 40,
      "max": 90,
      "step": 2,
      "default": 44,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Top/bottom padding",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 6,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "menu_gap",
      "label": "Menu item spacing",
      "min": 10,
      "max": 42,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "menu_font_size",
      "label": "Menu font size",
      "min": 8,
      "max": 16,
      "step": 1,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "menu_letter_spacing",
      "label": "Menu letter spacing",
      "min": 0,
      "max": 0.4,
      "step": 0.1,
      "default": 0.2
    },
    {
      "type": "range",
      "id": "icon_gap",
      "label": "Icon spacing",
      "min": 6,
      "max": 24,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist icon",
      "default": true
    },
    {
      "type": "url",
      "id": "wishlist_link",
      "label": "Wishlist link"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#273315"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text/icons",
      "default": "#efe9d8"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color (unused)",
      "default": "#52623b"
    }
  ],
  "presets": [
    {
      "name": "Perito Header"
    }
  ]
}
{% endschema %}