{% style %}
  .perito-philosophy {
    background: {{ section.settings.section_bg }};
    color: {{ section.settings.text_color }};
  }

  .perito-philosophy__inner {
    padding-top: calc(var(--perito-section-space-top) + {{ section.settings.padding_top }}px);
    padding-bottom: calc(var(--perito-section-space-bottom) + {{ section.settings.padding_bottom }}px);
  }

  .perito-philosophy__grid {
    display: grid;
    grid-template-columns: minmax(280px, {{ section.settings.content_width }}px) minmax(320px, {{ section.settings.image_width }}px);
    justify-content: space-between;
    align-items: start;
    column-gap: {{ section.settings.column_gap }}px;
  }

  .perito-philosophy__content {
    max-width: {{ section.settings.content_width }}px;
    padding-top: {{ section.settings.content_offset_top }}px;
  }

  .perito-philosophy__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_margin_bottom }}px;
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_font_size }}px;
    line-height: {{ section.settings.eyebrow_line_height }};
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}em;
    text-transform: uppercase;
    font-weight: {{ section.settings.eyebrow_font_weight }};
    opacity: 0.9;
  }

  .perito-philosophy__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size }}px;
    line-height: {{ section.settings.heading_line_height }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}em;
    font-weight: {{ section.settings.heading_font_weight }};
  }

  .perito-philosophy__lead {
    margin: {{ section.settings.lead_margin_top }}px 0 0;
    color: {{ section.settings.lead_color }};
    font-size: {{ section.settings.lead_font_size }}px;
    line-height: {{ section.settings.lead_line_height }};
    letter-spacing: {{ section.settings.lead_letter_spacing }}em;
    font-weight: {{ section.settings.lead_font_weight }};
    opacity: 0.95;
  }

  .perito-philosophy__body {
    margin: {{ section.settings.body_margin_top }}px 0 0;
    color: {{ section.settings.body_color }};
    font-size: {{ section.settings.body_font_size }}px;
    line-height: {{ section.settings.body_line_height }};
    letter-spacing: {{ section.settings.body_letter_spacing }}em;
    font-weight: {{ section.settings.body_font_weight }};
    opacity: 0.92;
  }

  .perito-philosophy__body p {
    margin: 0 0 {{ section.settings.paragraph_gap }}px;
  }

  .perito-philosophy__body p:last-child {
    margin-bottom: 0;
  }

  .perito-philosophy__quote {
    margin-top: {{ section.settings.quote_margin_top }}px;
    padding-top: {{ section.settings.quote_padding_top }}px;
    border-top: 1px solid {{ section.settings.divider_color }};
  }

  .perito-philosophy__quote-text {
    margin: 0;
    color: {{ section.settings.quote_color }};
    font-size: {{ section.settings.quote_font_size }}px;
    line-height: {{ section.settings.quote_line_height }};
    letter-spacing: {{ section.settings.quote_letter_spacing }}em;
    font-weight: {{ section.settings.quote_font_weight }};
    opacity: 0.95;
  }

  .perito-philosophy__quote-author {
    margin: {{ section.settings.quote_author_margin_top }}px 0 0;
    color: {{ section.settings.quote_author_color }};
    font-size: {{ section.settings.quote_author_font_size }}px;
    line-height: {{ section.settings.quote_author_line_height }};
    letter-spacing: {{ section.settings.quote_author_letter_spacing }}em;
    text-transform: uppercase;
    font-weight: {{ section.settings.quote_author_font_weight }};
    opacity: 0.88;
  }

  .perito-philosophy__media {
    width: 100%;
    max-width: {{ section.settings.image_width }}px;
    justify-self: end;
  }

  .perito-philosophy__image-wrap {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    background: {{ section.settings.image_bg }};
    overflow: hidden;
  }

  .perito-philosophy__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ section.settings.image_fit }};
    object-position: center center;
  }

  .perito-philosophy__placeholder {
    width: 100%;
    height: 100%;
    background: {{ section.settings.image_bg }};
  }

  @media screen and (max-width: 989px) {
    .perito-philosophy__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .perito-philosophy__grid {
      grid-template-columns: 1fr;
      row-gap: {{ section.settings.mobile_row_gap }}px;
    }

    .perito-philosophy__content {
      max-width: 100%;
      padding-top: 0;
    }

    .perito-philosophy__heading {
      font-size: {{ section.settings.mobile_heading_font_size }}px;
    }

    .perito-philosophy__lead {
      font-size: {{ section.settings.mobile_lead_font_size }}px;
    }

    .perito-philosophy__body {
      font-size: {{ section.settings.mobile_body_font_size }}px;
    }

    .perito-philosophy__media {
      max-width: 100%;
      justify-self: start;
    }

    .perito-philosophy__image-wrap {
      height: {{ section.settings.mobile_image_height }}px;
    }
  }
{% endstyle %}

{% capture philosophy_sizes %}(min-width: 990px) {{ section.settings.image_width }}px, 100vw{% endcapture %}

<section class="perito-philosophy">
  <div class="perito-philosophy__inner perito-container perito-section-inner">
    <div class="perito-philosophy__grid">
      <div class="perito-philosophy__content">
        {% if section.settings.eyebrow != blank %}
          <p class="perito-philosophy__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="perito-philosophy__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.lead != blank %}
          <div class="perito-philosophy__lead">{{ section.settings.lead }}</div>
        {% endif %}

        {% if section.settings.body != blank %}
          <div class="perito-philosophy__body">{{ section.settings.body }}</div>
        {% endif %}

        {% if section.settings.quote != blank or section.settings.quote_author != blank %}
          <div class="perito-philosophy__quote">
            {% if section.settings.quote != blank %}
              <p class="perito-philosophy__quote-text">“{{ section.settings.quote }}”</p>
            {% endif %}

            {% if section.settings.quote_author != blank %}
              <p class="perito-philosophy__quote-author">{{ section.settings.quote_author }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="perito-philosophy__media">
        <div class="perito-philosophy__image-wrap">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                class: 'perito-philosophy__image',
                loading: 'lazy',
                widths: '500, 700, 900, 1100, 1400',
                sizes: philosophy_sizes,
                alt: section.settings.heading
            }}
          {% else %}
            <div class="perito-philosophy__placeholder"></div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
