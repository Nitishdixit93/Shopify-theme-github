{% style %}
  .perito-story-intro {
    background: {{ section.settings.body_bg }};
    color: {{ section.settings.text_color }};
  }

  .perito-story-intro__hero {
    position: relative;
    min-height: {{ section.settings.hero_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .perito-story-intro__hero-image {
    position: absolute;
    inset: 0;
  }

  .perito-story-intro__hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .perito-story-intro__overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .perito-story-intro__hero-content {
    position: relative;
    z-index: 2;
    max-width: 560px;
    padding: 0 24px;
  }

  .perito-story-intro__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.1;
    font-weight: 300;
  }

  .perito-story-intro__subheading {
    margin: 18px 0 0;
    color: {{ section.settings.subheading_color }};
    font-size: {{ section.settings.subheading_size }}px;
    line-height: 1.6;
    font-weight: 300;
  }

  .perito-story-intro__body {
    background: {{ section.settings.body_bg }};
  }

  .perito-story-intro__body-inner {
    max-width: {{ section.settings.text_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.body_padding_top }}px 24px {{ section.settings.body_padding_bottom }}px;
  }

  .perito-story-intro__text {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.body_font_size }}px;
    line-height: {{ section.settings.body_line_height }};
    font-weight: 300;
  }

  .perito-story-intro__text p {
    margin: 0 0 {{ section.settings.paragraph_gap }}px;
  }

  .perito-story-intro__text p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .perito-story-intro__hero {
      min-height: {{ section.settings.mobile_hero_height }}px;
    }

    .perito-story-intro__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    .perito-story-intro__body-inner {
      padding-top: {{ section.settings.mobile_body_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_body_padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="perito-story-intro">
  <div class="perito-story-intro__hero">
    <div class="perito-story-intro__hero-image">
      {% if section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 2000
          | image_tag:
            loading: 'eager',
            widths: '800, 1200, 1600, 2000',
            alt: section.settings.heading
        }}
      {% endif %}
    </div>

    <div class="perito-story-intro__overlay"></div>

    <div class="perito-story-intro__hero-content">
      {% if section.settings.heading != blank %}
        <h1 class="perito-story-intro__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="perito-story-intro__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
  </div>

  <div class="perito-story-intro__body">
    <div class="perito-story-intro__body-inner">
      {% if section.settings.body_text != blank %}
        <div class="perito-story-intro__text">
          {{ section.settings.body_text }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Perito Story Intro",
  "tag": "section",
  "class": "section-perito-story-intro",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Building a perfume house that honors India's olfactory heritage"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Perito Moreno began with a simple belief: that India's extraordinary perfumery tradition deserves a contemporary voice. A voice that respects centuries of attar-making wisdom while embracing the possibilities of modern fragrance artistry.</p><p>Founded in 2018, we set out to create fragrances that capture the complexity of India — its seasons, landscapes, and cultural richness — without resorting to stereotypes or simplification. Each composition is a specific story, built from carefully sourced materials and guided by both traditional knowledge and contemporary technique.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Hero height",
      "min": 220,
      "max": 520,
      "step": 10,
      "default": 330,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Text width",
      "min": 520,
      "max": 900,
      "step": 20,
      "default": 680,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_padding_top",
      "label": "Body top padding",
      "min": 30,
      "max": 120,
      "step": 2,
      "default": 58,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_padding_bottom",
      "label": "Body bottom padding",
      "min": 30,
      "max": 120,
      "step": 2,
      "default": 70,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "paragraph_gap",
      "label": "Paragraph gap",
      "min": 10,
      "max": 36,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 70,
      "step": 1,
      "default": 44,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 10,
      "max": 22,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_line_height",
      "label": "Body line height",
      "min": 1.3,
      "max": 2.4,
      "step": 0.1,
      "default": 1.8
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_hero_height",
      "label": "Mobile hero height",
      "min": 220,
      "max": 460,
      "step": 10,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 26,
      "max": 48,
      "step": 1,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_body_padding_top",
      "label": "Mobile body top padding",
      "min": 24,
      "max": 80,
      "step": 2,
      "default": 42,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_body_padding_bottom",
      "label": "Mobile body bottom padding",
      "min": 24,
      "max": 80,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "body_bg",
      "label": "Body background",
      "default": "#273315"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#efe9d8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Hero heading",
      "default": "#f4efe4"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Hero subheading",
      "default": "#d9d2c4"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Hero overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Hero overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 55,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Perito Story Intro"
    }
  ]
}
{% endschema %}