{% style %}
.perito-shop-online-cta-{{ section.id }} {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  text-align: center;
  padding: {{ section.settings.padding_top }}px {{ section.settings.padding_sides }}px {{ section.settings.padding_bottom }}px;
}

.perito-shop-online-cta-{{ section.id }} .perito-shop-online-cta__inner {
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
}

.perito-shop-online-cta-{{ section.id }} .perito-shop-online-cta__heading {
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  font-weight: {{ section.settings.heading_weight }};
  line-height: 1.2;
  letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
}

.perito-shop-online-cta-{{ section.id }} .perito-shop-online-cta__description {
  color: {{ section.settings.description_color }};
  font-size: {{ section.settings.description_size }}px;
  font-weight: {{ section.settings.description_weight }};
  line-height: {{ section.settings.description_line_height }};
  max-width: {{ section.settings.description_width }}px;
  margin: 0 auto {{ section.settings.description_margin_bottom }}px;
}

.perito-shop-online-cta-{{ section.id }} .perito-shop-online-cta__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: {{ section.settings.button_min_width }}px;
  min-height: {{ section.settings.button_height }}px;
  padding: 0 {{ section.settings.button_padding_sides }}px;
  background-color: {{ section.settings.button_bg_color }};
  color: {{ section.settings.button_text_color }};
  border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
  font-size: {{ section.settings.button_text_size }}px;
  font-weight: {{ section.settings.button_text_weight }};
  line-height: 1;
  letter-spacing: {{ section.settings.button_letter_spacing }}px;
  text-transform: uppercase;
  text-decoration: none;
  transition: opacity 0.25s ease;
}

.perito-shop-online-cta-{{ section.id }} .perito-shop-online-cta__button:hover {
  opacity: 0.82;
}

.perito-shop-online-cta-{{ section.id }} .perito-shop-online-cta__bottom-space {
  display: {% if section.settings.show_bottom_space %}block{% else %}none{% endif %};
  height: {{ section.settings.bottom_space_height }}px;
  background-color: {{ section.settings.bottom_space_color }};
}

@media screen and (max-width: 749px) {
  .perito-shop-online-cta-{{ section.id }} {
    padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_sides }}px {{ section.settings.mobile_padding_bottom }}px;
  }

  .perito-shop-online-cta-{{ section.id }} .perito-shop-online-cta__heading {
    font-size: {{ section.settings.mobile_heading_size }}px;
  }

  .perito-shop-online-cta-{{ section.id }} .perito-shop-online-cta__description {
    font-size: {{ section.settings.mobile_description_size }}px;
    margin-bottom: {{ section.settings.mobile_description_margin_bottom }}px;
  }

  .perito-shop-online-cta-{{ section.id }} .perito-shop-online-cta__button {
    min-width: {{ section.settings.mobile_button_min_width }}px;
    min-height: {{ section.settings.mobile_button_height }}px;
  }

  .perito-shop-online-cta-{{ section.id }} .perito-shop-online-cta__bottom-space {
    height: {{ section.settings.mobile_bottom_space_height }}px;
  }
}
{% endstyle %}

<section class="perito-shop-online-cta-{{ section.id }}">
  <div class="perito-shop-online-cta__inner">
    {% if section.settings.heading != blank %}
      <h2 class="perito-shop-online-cta__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="perito-shop-online-cta__description">
        {{ section.settings.description }}
      </p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a class="perito-shop-online-cta__button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>

  <div class="perito-shop-online-cta__bottom-space"></div>
</section>

