{% style %}
  .perito-journal {
    background: {{ section.settings.section_bg }};
    color: {{ section.settings.text_color }};
  }

  .perito-journal__inner {
    padding-top: calc(var(--perito-section-space-top) + {{ section.settings.padding_top }}px);
    padding-bottom: calc(var(--perito-section-space-bottom) + {{ section.settings.padding_bottom }}px);
  }

  .perito-journal__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }

  .perito-journal__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_margin_bottom }}px;
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_font_size }}px;
    line-height: 1.2;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}em;
    text-transform: uppercase;
    font-weight: {{ section.settings.eyebrow_font_weight }};
  }

  .perito-journal__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size }}px;
    line-height: {{ section.settings.heading_line_height }};
    font-weight: {{ section.settings.heading_font_weight }};
  }

  .perito-journal__link {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    color: {{ section.settings.link_color }};
    text-decoration: none;
    text-transform: uppercase;
    font-size: {{ section.settings.link_font_size }}px;
    letter-spacing: {{ section.settings.link_letter_spacing }}em;
    line-height: 1;
    font-weight: {{ section.settings.link_font_weight }};
    white-space: nowrap;
  }

  .perito-journal__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: {{ section.settings.column_gap }}px;
    row-gap: {{ section.settings.row_gap }}px;
  }

  .perito-journal__card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .perito-journal__media {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    background: {{ section.settings.image_bg }};
    overflow: hidden;
    margin-bottom: {{ section.settings.card_content_top }}px;
  }

  .perito-journal__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ section.settings.image_fit }};
    object-position: center center;
    transition: transform 0.35s ease;
  }

  .perito-journal__card:hover .perito-journal__image {
    transform: scale(1.025);
  }

  .perito-journal__placeholder {
    width: 100%;
    height: 100%;
    background: {{ section.settings.image_bg }};
  }

  .perito-journal__category {
    margin: 0 0 {{ section.settings.category_margin_bottom }}px;
    color: {{ section.settings.category_color }};
    font-size: {{ section.settings.category_font_size }}px;
    line-height: 1.2;
    letter-spacing: {{ section.settings.category_letter_spacing }}em;
    text-transform: uppercase;
    font-weight: {{ section.settings.category_font_weight }};
  }

  .perito-journal__title {
    margin: 0 0 {{ section.settings.title_margin_bottom }}px;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_font_size }}px;
    line-height: {{ section.settings.title_line_height }};
    font-weight: {{ section.settings.title_font_weight }};
  }

  .perito-journal__excerpt {
    margin: 0 0 {{ section.settings.excerpt_margin_bottom }}px;
    color: {{ section.settings.excerpt_color }};
    font-size: {{ section.settings.excerpt_font_size }}px;
    line-height: {{ section.settings.excerpt_line_height }};
    font-weight: {{ section.settings.excerpt_font_weight }};
    opacity: 0.9;
  }

  .perito-journal__meta {
    margin: 0;
    color: {{ section.settings.meta_color }};
    font-size: {{ section.settings.meta_font_size }}px;
    line-height: 1.4;
    font-weight: {{ section.settings.meta_font_weight }};
    opacity: 0.8;
  }

  @media screen and (max-width: 989px) {
    .perito-journal__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .perito-journal__header {
      align-items: start;
      flex-direction: column;
    }

    .perito-journal__heading {
      font-size: {{ section.settings.mobile_heading_font_size }}px;
    }

    .perito-journal__grid {
      grid-template-columns: 1fr;
      row-gap: {{ section.settings.mobile_row_gap }}px;
    }

    .perito-journal__media {
      height: {{ section.settings.mobile_image_height }}px;
    }
  }
{% endstyle %}

<section class="perito-journal">
  <div class="perito-journal__inner perito-container perito-section-inner">
    <div class="perito-journal__header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="perito-journal__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="perito-journal__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>

      {% if section.settings.link_label != blank %}
        <a class="perito-journal__link" href="{{ section.settings.link_url | default: '#' }}">
          {{ section.settings.link_label }}
          <span>→</span>
        </a>
      {% endif %}
    </div>

    {% liquid
      assign fallback_excerpt = section.settings.fallback_excerpt | default: 'Discover stories, rituals, ingredients, and perspectives from the world of Perito Moreno.'
      assign rendered_articles = 0
      assign articles_per_blog = section.settings.articles_per_blog | default: 1
      assign blog_handles = section.settings.blog_handles | default: 'news' | split: ','
    %}

    {% capture journal_sizes %}(min-width: 990px) 33vw, 100vw{% endcapture %}

    <div class="perito-journal__grid">
      {% for handle in blog_handles %}
        {% assign handle_clean = handle | strip %}
        {% assign current_blog = blogs[handle_clean] %}
        {% if current_blog != blank %}
          {% assign blog_count = 0 %}
          {% for article in current_blog.articles %}
            {% if blog_count < articles_per_blog %}
              {% liquid
                assign blog_count = blog_count | plus: 1
                assign rendered_articles = rendered_articles | plus: 1

                assign first_tag = article.tags | first
                assign article_category = current_blog.title

                if first_tag != blank
                  assign article_category = current_blog.title | append: ' / ' | append: first_tag
                endif

                assign article_excerpt = article.excerpt_or_content | strip_html | strip | truncate: 145

                if article_excerpt == blank
                  assign article_excerpt = fallback_excerpt
                endif

                assign article_words = article.content | strip_html | split: ' ' | size
                assign read_minutes = article_words | divided_by: 200

                if read_minutes < 1
                  assign read_minutes = 1
                endif

                assign article_meta = article.published_at | date: '%b %d, %Y'
              %}

              <a class="perito-journal__card" href="{{ article.url }}">
                {% liquid
                  if rendered_articles == 1
                    assign fallback_img = section.settings.fallback_image_1
                  elsif rendered_articles == 2
                    assign fallback_img = section.settings.fallback_image_2
                  else
                    assign fallback_img = section.settings.fallback_image_3
                  endif
                %}
                <div class="perito-journal__media">
                  {% if article.image != blank %}
                    {{
                      article.image
                      | image_url: width: 1000
                      | image_tag:
                        class: 'perito-journal__image',
                        loading: 'lazy',
                        widths: '400, 600, 800, 1000',
                        sizes: journal_sizes,
                        alt: article.title
                    }}
                  {% elsif fallback_img != blank %}
                    {{
                      fallback_img
                      | image_url: width: 1000
                      | image_tag:
                        class: 'perito-journal__image',
                        loading: 'lazy',
                        widths: '400, 600, 800, 1000',
                        sizes: journal_sizes,
                        alt: article.title
                    }}
                  {% else %}
                    <div class="perito-journal__placeholder"></div>
                  {% endif %}
                </div>

                {% if article_category != blank %}
                  <p class="perito-journal__category">{{ article_category }}</p>
                {% endif %}

                <h3 class="perito-journal__title">{{ article.title }}</h3>
                <p class="perito-journal__excerpt">{{ article_excerpt }}</p>
                <p class="perito-journal__meta">{{ article_meta }} · {{ read_minutes }} min read</p>
              </a>
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}

      {% if rendered_articles == 0 %}
        {% for block in section.blocks %}
          <a class="perito-journal__card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
            <div class="perito-journal__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'perito-journal__image',
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000',
                    sizes: journal_sizes,
                    alt: block.settings.title
                }}
              {% else %}
                <div class="perito-journal__placeholder"></div>
              {% endif %}
            </div>
            {% if block.settings.category != blank %}
              <p class="perito-journal__category">{{ block.settings.category }}</p>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="perito-journal__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.excerpt != blank %}
              <p class="perito-journal__excerpt">{{ block.settings.excerpt }}</p>
            {% endif %}
            {% if block.settings.meta != blank %}
              <p class="perito-journal__meta">{{ block.settings.meta }}</p>
            {% endif %}
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
