{% style %}
  .perito-hero {
    background: {{ section.settings.section_bg }};
    color: {{ section.settings.text_color }};
  }

  .perito-hero__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
}

  .perito-hero__grid {
    display: grid;
    grid-template-columns: minmax(280px, {{ section.settings.content_column_width }}px) minmax(0, 1fr);
    align-items: center;
    column-gap: {{ section.settings.column_gap }}px;
    min-height: {{ section.settings.hero_height }}px;
  }

  .perito-hero__content {
    width: 100%;
    max-width: {{ section.settings.content_max_width }}px;
    justify-self: start;
  }

  .perito-hero__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_margin_bottom }}px;
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_font_size }}px;
    line-height: {{ section.settings.eyebrow_line_height }};
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}em;
    text-transform: uppercase;
    font-weight: {{ section.settings.eyebrow_font_weight }};
    opacity: 0.92;
  }

  .perito-hero__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size }}px;
    line-height: {{ section.settings.heading_line_height }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}em;
    font-weight: {{ section.settings.heading_font_weight }};
    max-width: {{ section.settings.heading_max_width }}px;
  }

  .perito-hero__desc {
    margin: {{ section.settings.desc_margin_top }}px 0 0;
    color: {{ section.settings.desc_color }};
    font-size: {{ section.settings.desc_font_size }}px;
    line-height: {{ section.settings.desc_line_height }};
    letter-spacing: {{ section.settings.desc_letter_spacing }}em;
    font-weight: {{ section.settings.desc_font_weight }};
    max-width: {{ section.settings.desc_max_width }}px;
    opacity: 0.94;
  }

  .perito-hero__buttons {
    display: flex;
    align-items: center;
    gap: {{ section.settings.button_gap }}px;
    margin-top: {{ section.settings.buttons_margin_top }}px;
    flex-wrap: wrap;
  }

  .perito-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: {{ section.settings.button_min_width }}px;
    height: {{ section.settings.button_height }}px;
    padding: 0 {{ section.settings.button_padding_x }}px;
    text-decoration: none;
    text-transform: uppercase;
    font-size: {{ section.settings.button_font_size }}px;
    line-height: 1;
    letter-spacing: {{ section.settings.button_letter_spacing }}em;
    font-weight: {{ section.settings.button_font_weight }};
    transition: opacity 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    box-sizing: border-box;
  }

  .perito-hero__btn--primary {
    background: {{ section.settings.primary_button_bg }};
    color: {{ section.settings.primary_button_text }};
    border: 1px solid {{ section.settings.primary_button_bg }};
  }

  .perito-hero__btn--secondary {
    background: transparent;
    color: {{ section.settings.secondary_button_text }};
    border: 1px solid {{ section.settings.secondary_button_border }};
  }

  .perito-hero__btn:hover {
    opacity: 0.92;
  }

  .perito-hero__media {
    display: flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    width: 100%;
  }

  .perito-hero__image-wrap {
    width: {{ section.settings.image_width }}px;
    height: {{ section.settings.image_height }}px;
    background: {{ section.settings.image_bg }};
    overflow: hidden;
    flex: 0 0 auto;
  }

  .perito-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center center;
  }

  .perito-hero__placeholder {
    width: 100%;
    height: 100%;
    background: {{ section.settings.image_bg }};
  }

  @media screen and (max-width: 989px) {
    .perito-hero__inner {
      padding:
        {{ section.settings.mobile_padding_top }}px
        {{ section.settings.mobile_padding_x }}px
        {{ section.settings.mobile_padding_bottom }}px;
    }

    .perito-hero__grid {
      grid-template-columns: 1fr;
      row-gap: {{ section.settings.mobile_row_gap }}px;
      min-height: auto;
    }

    .perito-hero__content {
      max-width: 100%;
      order: 2;
    }

    .perito-hero__media {
      order: 1;
    }

    .perito-hero__heading {
      max-width: 100%;
      font-size: {{ section.settings.mobile_heading_font_size }}px;
    }

    .perito-hero__desc {
      max-width: 100%;
      font-size: {{ section.settings.mobile_desc_font_size }}px;
    }

    .perito-hero__eyebrow {
      font-size: {{ section.settings.mobile_eyebrow_font_size }}px;
    }

    .perito-hero__btn {
      min-width: {{ section.settings.mobile_button_min_width }}px;
      height: {{ section.settings.mobile_button_height }}px;
      font-size: {{ section.settings.mobile_button_font_size }}px;
    }

    .perito-hero__image-wrap {
      width: min(100%, {{ section.settings.mobile_image_width }}px);
      height: auto;
      aspect-ratio: {{ section.settings.mobile_image_width }} / {{ section.settings.mobile_image_height }};
    }
  }
{% endstyle %}

{% capture hero_image_sizes %}(min-width: 990px) {{ section.settings.image_width }}px, 90vw{% endcapture %}

<section class="perito-hero">
  <div class="perito-hero__inner perito-container">
    <div class="perito-hero__grid">
      <div class="perito-hero__content">
        {% if section.settings.eyebrow != blank %}
          <p class="perito-hero__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="perito-hero__heading">{{ section.settings.heading }}</h1>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="perito-hero__desc">{{ section.settings.description }}</div>
        {% endif %}

        {% if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank %}
          <div class="perito-hero__buttons">
            {% if section.settings.primary_button_label != blank %}
              <a
                href="{{ section.settings.primary_button_link | default: '#' }}"
                class="perito-hero__btn perito-hero__btn--primary"
              >
                {{ section.settings.primary_button_label }}
              </a>
            {% endif %}

            {% if section.settings.secondary_button_label != blank %}
              <a
                href="{{ section.settings.secondary_button_link | default: '#' }}"
                class="perito-hero__btn perito-hero__btn--secondary"
              >
                {{ section.settings.secondary_button_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="perito-hero__media">
        <div class="perito-hero__image-wrap">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                class: 'perito-hero__image',
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1400, 1600',
                sizes: hero_image_sizes,
                alt: section.settings.heading
            }}
          {% else %}
            <div class="perito-hero__placeholder"></div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
