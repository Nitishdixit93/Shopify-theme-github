{% style %}
  .perito-journal {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text }};
  }

  .perito-journal__hero {
  min-height: {{ section.settings.hero_height }}px;
  background-image:
    linear-gradient(rgba(9, 20, 16, {{ section.settings.overlay_opacity | divided_by: 100.0 }}), rgba(9, 20, 16, {{ section.settings.overlay_opacity | divided_by: 100.0 }})),
    {% if section.settings.hero_image != blank %}
      url({{ section.settings.hero_image | image_url: width: 2200 }})
    {% else %}
      none
    {% endif %};
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 24px;
}

  .perito-journal__hero h1 {
    margin: 0;
    font-size: 64px;
    line-height: 1;
    font-weight: 300;
    letter-spacing: -0.04em;
    color: {{ section.settings.hero_text }};
  }

  .perito-journal__hero p {
    margin: 28px 0 0;
    font-size: 15px;
    color: {{ section.settings.hero_text }};
  }

  .perito-journal__inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 70px 64px 110px;
  }

  .perito-journal__eyebrow {
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 18px;
  }

  .perito-journal__heading {
    font-size: 38px;
    line-height: 1.05;
    margin: 0 0 56px;
    font-weight: 600;
  }

  .perito-journal__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 42px;
    row-gap: 72px;
  }

  .perito-journal-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .perito-journal-card__image {
    width: 100%;
    aspect-ratio: 1 / 1.33;
    overflow: hidden;
    background: #d9d9d9;
    margin-bottom: 24px;
  }

  .perito-journal-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .perito-journal-card__category {
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    opacity: 0.72;
    margin-bottom: 14px;
  }

  .perito-journal-card__title {
    font-size: 20px;
    line-height: 1.2;
    font-weight: 600;
    margin: 0 0 18px;
  }

  .perito-journal-card__excerpt {
    font-size: 13px;
    line-height: 1.65;
    opacity: 0.78;
    margin: 0 0 14px;
  }

  .perito-journal-card__meta {
    font-size: 11px;
    opacity: 0.55;
  }

  @media screen and (max-width: 989px) {
    .perito-journal__inner {
      padding: 56px 32px 80px;
    }

    .perito-journal__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 48px 28px;
    }

    .perito-journal__hero h1 {
      font-size: 48px;
    }
  }

  @media screen and (max-width: 640px) {
    .perito-journal__hero {
    min-height: {{ section.settings.mobile_hero_height }}px;
  }

    .perito-journal__hero h1 {
      font-size: 42px;
    }

    .perito-journal__inner {
      padding: 44px 20px 64px;
    }

    .perito-journal__grid {
      grid-template-columns: 1fr;
    }

    .perito-journal__heading {
      font-size: 30px;
      margin-bottom: 38px;
    }
  }
{% endstyle %}

<section class="perito-journal">
  <div class="perito-journal__hero">
    <div>
      <h1>{{ section.settings.hero_title }}</h1>

      {% if section.settings.hero_subtitle != blank %}
        <p>{{ section.settings.hero_subtitle }}</p>
      {% endif %}
    </div>
  </div>

  <div class="perito-journal__inner">
    {% if section.settings.eyebrow != blank %}
      <div class="perito-journal__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="perito-journal__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="perito-journal__grid">
      {% if blog.articles.size > 0 %}
        {% for article in blog.articles %}
          <a class="perito-journal-card" href="{{ article.url }}">
            <div class="perito-journal-card__image">
              {% if article.image != blank %}
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
              {% endif %}
            </div>

            <div class="perito-journal-card__category">
                {% if article.tags.size > 0 %}
                    {{ article.tags.first }}
                {% elsif blog.title != blank %}
                    {{ blog.title }}
                {% else %}
                    Journal
                {% endif %}
            </div>

            <h3 class="perito-journal-card__title">{{ article.title }}</h3>

            {% if article.excerpt != blank %}
              <p class="perito-journal-card__excerpt">
                {{ article.excerpt | strip_html | truncate: 130 }}
              </p>
            {% elsif article.content != blank %}
              <p class="perito-journal-card__excerpt">
                {{ article.content | strip_html | truncate: 130 }}
              </p>
            {% endif %}

            <div class="perito-journal-card__meta">
              {{ article.published_at | date: '%b %d, %Y' }}
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% assign fallback_titles = "Perfumer’s Journal|Fragrance Education|Stories Behind the Perfumes|Brand News & Launches" | split: "|" %}
        {% assign fallback_categories = "Craftsmanship|Behind the Scenes|Guide|Craftsmanship" | split: "|" %}
        {% assign fallback_excerpts = "Discover how to create your own signature scent by thoughtfully combining our fragrances.|A journey through the valleys of Bulgaria in search of the perfect rose absolute.|How to build a fragrance collection that evolves with the seasons.|Discover how to create your own signature scent by thoughtfully combining our fragrances." | split: "|" %}
        {% assign fallback_times = "5 min read|8 min read|6 min read|5 min read" | split: "|" %}

        {% for title in fallback_titles %}
          {% assign index = forloop.index0 %}

          <div class="perito-journal-card">
            <div class="perito-journal-card__image">
              {% if section.settings.fallback_image != blank %}
                {{ section.settings.fallback_image | image_url: width: 900 | image_tag: loading: 'lazy' }}
              {% endif %}
            </div>

            <div class="perito-journal-card__category">
              {{ fallback_categories[index] }}
            </div>

            <h3 class="perito-journal-card__title">
              {{ title }}
            </h3>

            <p class="perito-journal-card__excerpt">
              {{ fallback_excerpts[index] }}
            </p>

            <div class="perito-journal-card__meta">
              {{ fallback_times[index] }}
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Perito blog journal",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#1D3210"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text",
      "default": "#F4F0E7"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
  "type": "range",
  "id": "hero_height",
  "label": "Hero height",
  "min": 220,
  "max": 640,
  "step": 10,
  "default": 330,
  "unit": "px"
},
{
  "type": "range",
  "id": "mobile_hero_height",
  "label": "Mobile hero height",
  "min": 220,
  "max": 520,
  "step": 10,
  "default": 390,
  "unit": "px"
},
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Hero overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 65
    },
    {
      "type": "color",
      "id": "hero_text",
      "label": "Hero text",
      "default": "#F4F0E7"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero title",
      "default": "JOURNAL"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero subtitle",
      "default": "Stories of scent, seasonality, and craft"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stories & Insights"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Fallback card image"
    }
  ],
  "presets": [
    {
      "name": "Perito blog journal"
    }
  ]
}
{% endschema %}