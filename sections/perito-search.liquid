{% style %}
  .perito-search-page {
    background: {{ section.settings.section_bg }};
    color: {{ section.settings.text_color }};
  }

  .perito-search-page .perito-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding-left: 28px;
    padding-right: 28px;
  }

  .perito-search-page__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .perito-search-page__intro {
    max-width: {{ section.settings.intro_width }}px;
    margin: 0 auto {{ section.settings.intro_margin_bottom }}px;
    text-align: center;
  }

  .perito-search-page__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size }}px;
    line-height: {{ section.settings.heading_line_height }};
    font-weight: {{ section.settings.heading_font_weight }};
  }

  .perito-search-page__search-wrap {
    max-width: {{ section.settings.search_width }}px;
    margin: {{ section.settings.search_margin_top }}px auto 0;
  }

  .perito-search-page__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    border: 1px solid {{ section.settings.search_border }};
    background: {{ section.settings.search_bg }};
    height: {{ section.settings.search_height }}px;
  }

  .perito-search-page__input {
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
    color: {{ section.settings.search_text }};
    padding: 0 18px;
    font-size: {{ section.settings.search_font_size }}px;
    letter-spacing: {{ section.settings.search_letter_spacing }}em;
    outline: none;
  }

  .perito-search-page__input::placeholder {
    color: {{ section.settings.search_placeholder_color }};
    opacity: 1;
  }

  .perito-search-page__button {
    width: {{ section.settings.search_button_width }}px;
    height: 100%;
    border: 0;
    border-left: 1px solid {{ section.settings.search_border }};
    background: {{ section.settings.search_button_bg }};
    color: {{ section.settings.search_button_text }};
    cursor: pointer;
    text-transform: uppercase;
    font-size: {{ section.settings.search_button_font_size }}px;
    letter-spacing: {{ section.settings.search_button_letter_spacing }}em;
  }

  .perito-search-page__button:hover {
    opacity: 0.92;
  }

  .perito-search-page__count {
    margin: 0 0 {{ section.settings.count_margin_bottom }}px;
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.count_font_size }}px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .perito-search-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: {{ section.settings.column_gap }}px;
    row-gap: {{ section.settings.row_gap }}px;
  }

  .perito-search-page__card {
    color: inherit;
    text-decoration: none;
  }

  .perito-search-page__media {
    position: relative;
    width: 100%;
    height: {{ section.settings.image_height }}px;
    overflow: hidden;
    background: {{ section.settings.image_bg }};
    margin-bottom: {{ section.settings.card_content_top }}px;
  }

  .perito-search-page__image {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center center;
    transition: transform 0.35s ease;
  }

  .perito-search-page__card:hover .perito-search-page__image {
    transform: scale(1.025);
  }

  .perito-search-page__placeholder {
    width: 100%;
    height: 100%;
    background: {{ section.settings.image_bg }};
  }

  .perito-search-page__badges {
    position: absolute;
    top: {{ section.settings.badge_top }}px;
    left: {{ section.settings.badge_left }}px;
    display: grid;
    gap: {{ section.settings.badge_gap }}px;
    z-index: 2;
  }

  .perito-search-page__badge {
    min-width: {{ section.settings.badge_width }}px;
    height: {{ section.settings.badge_height }}px;
    padding: 0 10px;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text }};
    display: inline-flex;
    align-items: center;
    font-size: {{ section.settings.badge_font_size }}px;
    letter-spacing: {{ section.settings.badge_letter_spacing }}em;
    text-transform: uppercase;
  }

  .perito-search-page__wishlist {
    position: absolute;
    top: {{ section.settings.wishlist_top }}px;
    right: {{ section.settings.wishlist_right }}px;
    width: {{ section.settings.wishlist_size }}px;
    height: {{ section.settings.wishlist_size }}px;
    background: {{ section.settings.wishlist_bg }};
    color: {{ section.settings.wishlist_color }};
    border: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    cursor: pointer;
  }

  .perito-search-page__wishlist svg {
    width: 18px;
    height: 18px;
  }

  .perito-search-page__vendor {
    margin: 0 0 {{ section.settings.vendor_margin_bottom }}px;
    color: {{ section.settings.vendor_color }};
    font-size: {{ section.settings.vendor_font_size }}px;
    letter-spacing: {{ section.settings.vendor_letter_spacing }}em;
    text-transform: uppercase;
  }

  .perito-search-page__title {
    margin: 0 0 {{ section.settings.title_margin_bottom }}px;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_font_size }}px;
    line-height: {{ section.settings.title_line_height }};
    font-weight: {{ section.settings.title_font_weight }};
  }

  .perito-search-page__product-desc {
    margin: 0 0 {{ section.settings.product_desc_margin_bottom }}px;
    color: {{ section.settings.product_desc_color }};
    font-size: {{ section.settings.product_desc_font_size }}px;
    line-height: {{ section.settings.product_desc_line_height }};

    display: -webkit-box;
    -webkit-line-clamp: {{ section.settings.product_desc_lines }};
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .perito-search-page__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .perito-search-page__price {
    color: {{ section.settings.price_color }};
    font-size: {{ section.settings.price_font_size }}px;
  }

  .perito-search-page__size {
    color: {{ section.settings.size_color }};
    font-size: {{ section.settings.size_font_size }}px;
  }

  .perito-search-page__empty {
    margin: 40px auto 0;
    max-width: 620px;
    text-align: center;
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.empty_font_size }}px;
    line-height: 1.8;
  }

  .perito-search-page__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 56px;
  }

  .perito-search-page__pagination a,
  .perito-search-page__pagination span {
    min-width: 36px;
    height: 36px;
    padding: 0 12px;
    border: 1px solid {{ section.settings.search_border }};
    color: {{ section.settings.text_color }};
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 8px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .perito-search-page__pagination .current {
    background: {{ section.settings.text_color }};
    color: {{ section.settings.section_bg }};
  }

  @keyframes perito-search-heart-pop {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.6); opacity: 0.8; }
    100% { transform: scale(1); opacity: 1; }
  }

  .perito-search-page__wishlist.heart-pop svg {
    animation: perito-search-heart-pop 0.5s ease-in-out;
  }

  .perito-search-page__wishlist.active svg {
    fill: #e63946;
    stroke: #e63946;
  }

  @media screen and (max-width: 989px) {
    .perito-search-page .perito-container {
      padding-left: 16px;
      padding-right: 16px;
    }

    .perito-search-page__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .perito-search-page__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    .perito-search-page__form {
      grid-template-columns: 1fr;
      height: auto;
    }

    .perito-search-page__input {
      height: {{ section.settings.search_height }}px;
      text-align: center;
    }

    .perito-search-page__button {
      width: 100%;
      height: {{ section.settings.search_height }}px;
      border-left: 0;
      border-top: 1px solid {{ section.settings.search_border }};
    }

    .perito-search-page__grid {
      grid-template-columns: 1fr;
      row-gap: {{ section.settings.mobile_row_gap }}px;
    }

    .perito-search-page__media {
      height: {{ section.settings.mobile_image_height }}px;
    }
  }
{% endstyle %}

{% liquid
  assign has_search_query = false
  assign search_query = search.terms | strip

  if search.performed and search_query != blank
    assign has_search_query = true
  endif

  assign default_collection = section.settings.default_collection

  if default_collection == blank
    assign default_collection = collections.all
  endif

  assign products_per_page = section.settings.products_per_page

  assign badge_1_tag = section.settings.badge_1_type | prepend: 'badge:'
  assign badge_2_tag = section.settings.badge_2_type | prepend: 'badge:'
  assign badge_3_tag = section.settings.badge_3_type | prepend: 'badge:'
%}

<section class="perito-search-page">
  <div class="perito-search-page__inner perito-container">
    <div class="perito-search-page__intro">
      <h1 class="perito-search-page__heading">
        {{ section.settings.heading }}
      </h1>

      <div class="perito-search-page__search-wrap">
        <form action="{{ routes.search_url }}" method="get" role="search" class="perito-search-page__form">
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">

          <input
            class="perito-search-page__input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_placeholder | escape }}"
            aria-label="Search products"
          >

          <button class="perito-search-page__button" type="submit">
            {{ section.settings.search_button_label }}
          </button>
        </form>
      </div>
    </div>

    {% if has_search_query %}
      {% paginate search.results by products_per_page %}
        {% assign products = search.results | where: 'object_type', 'product' %}

        <p class="perito-search-page__count">
          {% if products.size == 1 %}
            Showing 1 result for “{{ search.terms | escape }}”
          {% else %}
            Showing {{ search.results_count }} results for “{{ search.terms | escape }}”
          {% endif %}
        </p>

        {% if products.size > 0 %}
          <div class="perito-search-page__grid">
            {% for product in products %}
              {% liquid
                assign product_size = ''
                assign display_variant = product.selected_or_first_available_variant

                if display_variant == blank
                  assign display_variant = product.variants.first
                endif

                assign variant_title = display_variant.title | strip
                assign variant_title_downcase = variant_title | downcase

                assign option_1 = display_variant.option1 | strip
                assign option_1_downcase = option_1 | downcase

                assign option_2 = display_variant.option2 | strip
                assign option_2_downcase = option_2 | downcase

                assign option_3 = display_variant.option3 | strip
                assign option_3_downcase = option_3 | downcase

                if option_1 != blank and option_1 != 'Default Title' and option_1_downcase contains 'ml'
                  assign product_size = option_1
                elsif option_1 != blank and option_1 != 'Default Title' and option_1_downcase contains 'gm'
                  assign product_size = option_1
                elsif option_1 != blank and option_1 != 'Default Title' and option_1_downcase contains 'gram'
                  assign product_size = option_1
                elsif option_2 != blank and option_2 != 'Default Title' and option_2_downcase contains 'ml'
                  assign product_size = option_2
                elsif option_2 != blank and option_2 != 'Default Title' and option_2_downcase contains 'gm'
                  assign product_size = option_2
                elsif option_2 != blank and option_2 != 'Default Title' and option_2_downcase contains 'gram'
                  assign product_size = option_2
                elsif option_3 != blank and option_3 != 'Default Title' and option_3_downcase contains 'ml'
                  assign product_size = option_3
                elsif option_3 != blank and option_3 != 'Default Title' and option_3_downcase contains 'gm'
                  assign product_size = option_3
                elsif option_3 != blank and option_3 != 'Default Title' and option_3_downcase contains 'gram'
                  assign product_size = option_3
                elsif variant_title_downcase contains 'ml'
                  assign product_size = variant_title | split: ' / ' | first
                elsif variant_title_downcase contains 'gm'
                  assign product_size = variant_title | split: ' / ' | first
                elsif variant_title_downcase contains 'gram'
                  assign product_size = variant_title | split: ' / ' | first
                endif

                assign metafield_size = ''

                if product.metafields.custom.size != blank
                  assign metafield_size = product.metafields.custom.size.value | default: product.metafields.custom.size | strip

                  if metafield_size == '0'
                    assign metafield_size = ''
                  endif
                endif

                if product_size == blank and metafield_size != blank
                  assign product_size = metafield_size
                endif
              %}

              <a class="perito-search-page__card" href="{{ product.url }}">
                <div class="perito-search-page__media">
                  <div class="perito-search-page__badges">
                    {% if section.settings.badge_1_type != 'none' and product.tags contains badge_1_tag %}
                      <span class="perito-search-page__badge">{{ section.settings.badge_1_label }}</span>
                    {% endif %}

                    {% if section.settings.badge_2_type != 'none' and product.tags contains badge_2_tag %}
                      <span class="perito-search-page__badge">{{ section.settings.badge_2_label }}</span>
                    {% endif %}

                    {% if section.settings.badge_3_type != 'none' and product.tags contains badge_3_tag %}
                      <span class="perito-search-page__badge">{{ section.settings.badge_3_label }}</span>
                    {% endif %}
                  </div>

                  <button
                    class="perito-search-page__wishlist"
                    data-handle="{{ product.handle }}"
                    aria-label="Add to wishlist"
                    type="button"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                      <path d="M15.8337 11.6667C17.0753 10.45 18.3337 8.99167 18.3337 7.08333C18.3337 5.86776 17.8508 4.70197 16.9912 3.84243C16.1317 2.98289 14.9659 2.5 13.7503 2.5C12.2837 2.5 11.2503 2.91667 10.0003 4.16667C8.75033 2.91667 7.71699 2.5 6.25033 2.5C5.03475 2.5 3.86896 2.98289 3.00942 3.84243C2.14988 4.70197 1.66699 5.86776 1.66699 7.08333C1.66699 9 2.91699 10.4583 4.16699 11.6667L10.0003 17.5L15.8337 11.6667Z" stroke="#283416" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>

                  {% if product.featured_image != blank %}
                    {{
                      product.featured_image
                      | image_url: width: 900
                      | image_tag:
                        class: 'perito-search-page__image',
                        loading: 'lazy',
                        widths: '400, 600, 700, 900',
                        sizes: '(min-width: 990px) 33vw, 100vw',
                        alt: product.title
                    }}
                  {% else %}
                    <div class="perito-search-page__placeholder"></div>
                  {% endif %}
                </div>

                <p class="perito-search-page__vendor">
                  {% if product.metafields.custom.collection_name != blank %}
                    {{ product.metafields.custom.collection_name }}
                  {% elsif product.collections.first != blank %}
                    {{ product.collections.first.title }}
                  {% else %}
                    {{ product.vendor }}
                  {% endif %}
                </p>

                <h2 class="perito-search-page__title">{{ product.title }}</h2>

                <p class="perito-search-page__product-desc">
                    {% if section.settings.product_desc_source == 'custom' %}
                        {% if product.metafields.custom.short_description != blank %}
                        {{ product.metafields.custom.short_description }}
                        {% elsif section.settings.product_desc_custom_fallback %}
                        {{ product.description | strip_html }}
                        {% endif %}
                    {% else %}
                        {{ product.description | strip_html }}
                    {% endif %}
                </p>

                <div class="perito-search-page__price-row">
                  <span class="perito-search-page__price">
                    {% render 'format-price', price: display_variant.price %}
                  </span>

                  {% if product_size != blank %}
                    <span class="perito-search-page__size">{{ product_size }}</span>
                  {% endif %}
                </div>
              </a>
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <div class="perito-search-page__pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}">Prev</a>
              {% endif %}

              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a href="{{ part.url }}">{{ part.title }}</a>
                {% else %}
                  <span class="{% if part.title == paginate.current_page %}current{% endif %}">
                    {{ part.title }}
                  </span>
                {% endif %}
              {% endfor %}

              {% if paginate.next %}
                <a href="{{ paginate.next.url }}">Next</a>
              {% endif %}
            </div>
          {% endif %}
        {% else %}
          <div class="perito-search-page__empty">
            {{ section.settings.no_results_text }}
          </div>
        {% endif %}
      {% endpaginate %}
    {% else %}
      {% paginate default_collection.products by products_per_page %}
        <p class="perito-search-page__count">
            {% assign showing_count = paginate.page_size %}
            {% assign showing_until = paginate.current_offset | plus: paginate.page_size %}

            {% if showing_until > paginate.items %}
                {% assign showing_count = paginate.items | minus: paginate.current_offset %}
            {% endif %}

            Showing {{ showing_count }} of {{ paginate.items }} products
        </p>

        <div class="perito-search-page__grid">
          {% for product in default_collection.products %}
            {% liquid
              assign product_size = ''
              assign display_variant = product.selected_or_first_available_variant

              if display_variant == blank
                assign display_variant = product.variants.first
              endif

              assign variant_title = display_variant.title | strip
              assign variant_title_downcase = variant_title | downcase

              assign option_1 = display_variant.option1 | strip
              assign option_1_downcase = option_1 | downcase

              assign option_2 = display_variant.option2 | strip
              assign option_2_downcase = option_2 | downcase

              assign option_3 = display_variant.option3 | strip
              assign option_3_downcase = option_3 | downcase

              if option_1 != blank and option_1 != 'Default Title' and option_1_downcase contains 'ml'
                assign product_size = option_1
              elsif option_1 != blank and option_1 != 'Default Title' and option_1_downcase contains 'gm'
                assign product_size = option_1
              elsif option_1 != blank and option_1 != 'Default Title' and option_1_downcase contains 'gram'
                assign product_size = option_1
              elsif option_2 != blank and option_2 != 'Default Title' and option_2_downcase contains 'ml'
                assign product_size = option_2
              elsif option_2 != blank and option_2 != 'Default Title' and option_2_downcase contains 'gm'
                assign product_size = option_2
              elsif option_2 != blank and option_2 != 'Default Title' and option_2_downcase contains 'gram'
                assign product_size = option_2
              elsif option_3 != blank and option_3 != 'Default Title' and option_3_downcase contains 'ml'
                assign product_size = option_3
              elsif option_3 != blank and option_3 != 'Default Title' and option_3_downcase contains 'gm'
                assign product_size = option_3
              elsif option_3 != blank and option_3 != 'Default Title' and option_3_downcase contains 'gram'
                assign product_size = option_3
              elsif variant_title_downcase contains 'ml'
                assign product_size = variant_title | split: ' / ' | first
              elsif variant_title_downcase contains 'gm'
                assign product_size = variant_title | split: ' / ' | first
              elsif variant_title_downcase contains 'gram'
                assign product_size = variant_title | split: ' / ' | first
              endif

              assign metafield_size = ''

              if product.metafields.custom.size != blank
                assign metafield_size = product.metafields.custom.size.value | default: product.metafields.custom.size | strip

                if metafield_size == '0'
                  assign metafield_size = ''
                endif
              endif

              if product_size == blank and metafield_size != blank
                assign product_size = metafield_size
              endif
            %}

            <a class="perito-search-page__card" href="{{ product.url }}">
              <div class="perito-search-page__media">
                <div class="perito-search-page__badges">
                  {% if section.settings.badge_1_type != 'none' and product.tags contains badge_1_tag %}
                    <span class="perito-search-page__badge">{{ section.settings.badge_1_label }}</span>
                  {% endif %}

                  {% if section.settings.badge_2_type != 'none' and product.tags contains badge_2_tag %}
                    <span class="perito-search-page__badge">{{ section.settings.badge_2_label }}</span>
                  {% endif %}

                  {% if section.settings.badge_3_type != 'none' and product.tags contains badge_3_tag %}
                    <span class="perito-search-page__badge">{{ section.settings.badge_3_label }}</span>
                  {% endif %}
                </div>

                <button
                  class="perito-search-page__wishlist"
                  data-handle="{{ product.handle }}"
                  aria-label="Add to wishlist"
                  type="button"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M15.8337 11.6667C17.0753 10.45 18.3337 8.99167 18.3337 7.08333C18.3337 5.86776 17.8508 4.70197 16.9912 3.84243C16.1317 2.98289 14.9659 2.5 13.7503 2.5C12.2837 2.5 11.2503 2.91667 10.0003 4.16667C8.75033 2.91667 7.71699 2.5 6.25033 2.5C5.03475 2.5 3.86896 2.98289 3.00942 3.84243C2.14988 4.70197 1.66699 5.86776 1.66699 7.08333C1.66699 9 2.91699 10.4583 4.16699 11.6667L10.0003 17.5L15.8337 11.6667Z" stroke="#283416" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>

                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      class: 'perito-search-page__image',
                      loading: 'lazy',
                      widths: '400, 600, 700, 900',
                      sizes: '(min-width: 990px) 33vw, 100vw',
                      alt: product.title
                  }}
                {% else %}
                  <div class="perito-search-page__placeholder"></div>
                {% endif %}
              </div>

              <p class="perito-search-page__vendor">
                {% if product.metafields.custom.collection_name != blank %}
                  {{ product.metafields.custom.collection_name }}
                {% elsif product.collections.first != blank %}
                  {{ product.collections.first.title }}
                {% else %}
                  {{ product.vendor }}
                {% endif %}
              </p>

              <h2 class="perito-search-page__title">{{ product.title }}</h2>

              <p class="perito-search-page__product-desc">
                {% if section.settings.product_desc_source == 'custom' %}
                    {% if product.metafields.custom.short_description != blank %}
                    {{ product.metafields.custom.short_description }}
                    {% elsif section.settings.product_desc_custom_fallback %}
                    {{ product.description | strip_html }}
                    {% endif %}
                {% else %}
                    {{ product.description | strip_html }}
                {% endif %}
            </p>

              <div class="perito-search-page__price-row">
                <span class="perito-search-page__price">
                  {% render 'format-price', price: display_variant.price %}
                </span>

                {% if product_size != blank %}
                  <span class="perito-search-page__size">{{ product_size }}</span>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="perito-search-page__pagination">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}">Prev</a>
            {% endif %}

            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {% else %}
                <span class="{% if part.title == paginate.current_page %}current{% endif %}">
                  {{ part.title }}
                </span>
              {% endif %}
            {% endfor %}

            {% if paginate.next %}
              <a href="{{ paginate.next.url }}">Next</a>
            {% endif %}
          </div>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const wishlistKey = 'peritoWishlist';

  function getWishlist() {
    try {
      return JSON.parse(localStorage.getItem(wishlistKey) || '[]');
    } catch {
      return [];
    }
  }

  function saveWishlist(list) {
    localStorage.setItem(wishlistKey, JSON.stringify(list));
  }

  function toggleWishlist(handle, btn) {
    let list = getWishlist();
    const index = list.indexOf(handle);

    if (index >= 0) {
      list.splice(index, 1);
      btn.classList.remove('active');
    } else {
      list.push(handle);
      btn.classList.add('active');
    }

    saveWishlist(list);

    btn.classList.add('heart-pop');
    setTimeout(() => btn.classList.remove('heart-pop'), 600);

    window.dispatchEvent(new CustomEvent('perito:wishlist-updated', {
      detail: { wishlist: list }
    }));
  }

  const buttons = document.querySelectorAll('.perito-search-page__wishlist');

  buttons.forEach(btn => {
    const handle = btn.dataset.handle;
    if (!handle) return;

    const list = getWishlist();
    if (list.includes(handle)) btn.classList.add('active');

    btn.addEventListener('click', e => {
      e.preventDefault();
      e.stopPropagation();
      toggleWishlist(handle, btn);
    });
  });

  window.addEventListener('storage', () => {
    buttons.forEach(btn => {
      const handle = btn.dataset.handle;
      const list = getWishlist();
      btn.classList.toggle('active', list.includes(handle));
    });
  });
});
</script>

