{% style %}
.perito-how-we-create {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_top }}px {{ section.settings.padding_sides }}px {{ section.settings.padding_bottom }}px;
}

.perito-how-we-create__inner {
  max-width: {{ section.settings.section_max_width }}px;
  margin: 0 auto;
}

.perito-how-we-create__header {
  text-align: center;
  margin-bottom: {{ section.settings.header_margin_bottom }}px;
}

.perito-how-we-create__heading {
  color: {{ section.settings.text_color }};
  font-size: {{ section.settings.heading_size }}px;
  font-weight: {{ section.settings.heading_weight }};
  line-height: 1.1;
  letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
}

.perito-how-we-create__description {
  color: {{ section.settings.description_color }};
  font-size: {{ section.settings.description_size }}px;
  font-weight: {{ section.settings.description_weight }};
  line-height: {{ section.settings.description_line_height }};
  margin: 0 auto;
  max-width: {{ section.settings.description_max_width }}px;
}

.perito-how-we-create__steps {
  max-width: {{ section.settings.steps_max_width }}px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: {{ section.settings.step_gap }}px;
}

.perito-how-we-create__step {
  display: grid;
  grid-template-columns: {{ section.settings.line_width }}px 1fr;
  gap: {{ section.settings.line_text_gap }}px;
  align-items: start;
}

.perito-how-we-create__line {
  width: {{ section.settings.line_width }}px;
  height: {{ section.settings.line_height }}px;
  background-color: {{ section.settings.line_color }};
  margin-top: {{ section.settings.line_margin_top }}px;
}

.perito-how-we-create__content {
  padding-top: 0;
}

.perito-how-we-create__title {
  color: {{ section.settings.text_color }};
  font-size: {{ section.settings.step_title_size }}px;
  font-weight: {{ section.settings.step_title_weight }};
  line-height: 1.25;
  margin: 0 0 {{ section.settings.step_title_margin_bottom }}px;
}

.perito-how-we-create__number {
  margin-right: {{ section.settings.number_gap }}px;
}

.perito-how-we-create__text {
  color: {{ section.settings.step_text_color }};
  font-size: {{ section.settings.step_text_size }}px;
  font-weight: {{ section.settings.step_text_weight }};
  line-height: {{ section.settings.step_text_line_height }};
  margin: 0;
}

@media screen and (max-width: 749px) {
  .perito-how-we-create {
    padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_sides }}px {{ section.settings.mobile_padding_bottom }}px;
  }

  .perito-how-we-create__heading {
    font-size: {{ section.settings.mobile_heading_size }}px;
  }

  .perito-how-we-create__description {
    font-size: {{ section.settings.mobile_description_size }}px;
  }

  .perito-how-we-create__steps {
    gap: {{ section.settings.mobile_step_gap }}px;
  }

  .perito-how-we-create__step {
    gap: {{ section.settings.mobile_line_text_gap }}px;
  }

  .perito-how-we-create__title {
    font-size: {{ section.settings.mobile_step_title_size }}px;
  }

  .perito-how-we-create__text {
    font-size: {{ section.settings.mobile_step_text_size }}px;
  }
}
{% endstyle %}

<section class="perito-how-we-create">
  <div class="perito-how-we-create__inner">
    <div class="perito-how-we-create__header">
      {% if section.settings.section_title != blank %}
        <h2 class="perito-how-we-create__heading">
          {{ section.settings.section_title }}
        </h2>
      {% endif %}

      {% if section.settings.section_description != blank %}
        <p class="perito-how-we-create__description">
          {{ section.settings.section_description }}
        </p>
      {% endif %}
    </div>

    <div class="perito-how-we-create__steps">
      {% for block in section.blocks %}
        {% liquid
          assign step_number = forloop.index
          if step_number < 10
            assign formatted_number = step_number | prepend: '0'
          else
            assign formatted_number = step_number
          endif
        %}

        <div class="perito-how-we-create__step" {{ block.shopify_attributes }}>
          <div class="perito-how-we-create__line"></div>

          <div class="perito-how-we-create__content">
            {% if block.settings.step_title != blank %}
              <h3 class="perito-how-we-create__title">
                <span class="perito-how-we-create__number">{{ formatted_number }}.</span>{{ block.settings.step_title }}
              </h3>
            {% endif %}

            {% if block.settings.step_text != blank %}
              <p class="perito-how-we-create__text">
                {{ block.settings.step_text }}
              </p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

