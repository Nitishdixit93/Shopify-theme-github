{% style %}
  .perito-story-philosophy {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text_color }};
  }

  .perito-story-philosophy__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding:
      {{ section.settings.padding_top }}px
      {{ section.settings.padding_x }}px
      {{ section.settings.padding_bottom }}px;
  }

  .perito-story-philosophy__grid {
    display: grid;
    grid-template-columns: minmax(420px, 640px) minmax(420px, 600px);
    align-items: center;
    gap: {{ section.settings.column_gap }}px;
  }

  .perito-story-philosophy__image {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    overflow: hidden;
    background: #d9d9d9;
  }

  .perito-story-philosophy__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .perito-story-philosophy__content {
    max-width: {{ section.settings.content_width }}px;
  }

  .perito-story-philosophy__heading {
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.1;
    font-weight: 500;
  }

  .perito-story-philosophy__text {
    margin: 0 0 {{ section.settings.items_margin_top }}px;
    color: {{ section.settings.body_color }};
    font-size: {{ section.settings.body_size }}px;
    line-height: {{ section.settings.body_line_height }};
    font-weight: 300;
  }

  .perito-story-philosophy__items {
    display: grid;
    gap: {{ section.settings.item_gap }}px;
  }

  .perito-story-philosophy__item {
    border-left: 2px solid {{ section.settings.accent_color }};
    padding-left: {{ section.settings.item_padding_left }}px;
  }

  .perito-story-philosophy__item-title {
    margin: 0 0 8px;
    color: {{ section.settings.item_title_color }};
    font-size: {{ section.settings.item_title_size }}px;
    line-height: 1.2;
    font-weight: 500;
  }

  .perito-story-philosophy__item-text {
    margin: 0;
    color: {{ section.settings.item_text_color }};
    font-size: {{ section.settings.item_text_size }}px;
    line-height: {{ section.settings.item_text_line_height }};
    font-weight: 300;
  }

  @media screen and (max-width: 989px) {
    .perito-story-philosophy__inner {
      padding:
        {{ section.settings.mobile_padding_top }}px
        {{ section.settings.mobile_padding_x }}px
        {{ section.settings.mobile_padding_bottom }}px;
    }

    .perito-story-philosophy__grid {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_gap }}px;
    }

    .perito-story-philosophy__image {
      height: {{ section.settings.mobile_image_height }}px;
    }

    .perito-story-philosophy__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<section class="perito-story-philosophy">
  <div class="perito-story-philosophy__inner">
    <div class="perito-story-philosophy__grid">
      <div class="perito-story-philosophy__media">
        <div class="perito-story-philosophy__image">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '600, 900, 1200, 1400',
                alt: section.settings.heading
            }}
          {% endif %}
        </div>
      </div>

      <div class="perito-story-philosophy__content">
        {% if section.settings.heading != blank %}
          <h2 class="perito-story-philosophy__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="perito-story-philosophy__text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        <div class="perito-story-philosophy__items">
          {% for block in section.blocks %}
            <div class="perito-story-philosophy__item" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h3 class="perito-story-philosophy__item-title">{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <p class="perito-story-philosophy__item-text">{{ block.settings.text }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Perito Story Philosophy",
  "tag": "section",
  "class": "section-perito-story-philosophy",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Philosophy"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "We believe in small-batch production, transparent sourcing, and collector-grade quality. Every fragrance is composed with intention, using materials chosen for their character and provenance."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 40,
      "max": 180,
      "step": 4,
      "default": 96,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 40,
      "max": 180,
      "step": 4,
      "default": 96,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Side padding",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 40,
      "max": 160,
      "step": 4,
      "default": 96,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "min": 500,
      "max": 900,
      "step": 10,
      "default": 800,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 420,
      "max": 720,
      "step": 10,
      "default": 610,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "items_margin_top",
      "label": "Items top spacing",
      "min": 30,
      "max": 90,
      "step": 2,
      "default": 58,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Item gap",
      "min": 14,
      "max": 44,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_padding_left",
      "label": "Item left padding",
      "min": 12,
      "max": 36,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 30,
      "max": 72,
      "step": 1,
      "default": 44,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading bottom spacing",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 17,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_line_height",
      "label": "Body line height",
      "min": 1.3,
      "max": 2.2,
      "step": 0.1,
      "default": 1.8
    },
    {
      "type": "range",
      "id": "item_title_size",
      "label": "Item title size",
      "min": 14,
      "max": 26,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_text_size",
      "label": "Item text size",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_text_line_height",
      "label": "Item text line height",
      "min": 1.3,
      "max": 2.2,
      "step": 0.1,
      "default": 1.7
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 30,
      "max": 100,
      "step": 2,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 30,
      "max": 100,
      "step": 2,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_x",
      "label": "Mobile side padding",
      "min": 16,
      "max": 40,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 24,
      "max": 70,
      "step": 2,
      "default": 42,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile image height",
      "min": 300,
      "max": 620,
      "step": 10,
      "default": 460,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 28,
      "max": 52,
      "step": 1,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#637236"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base text",
      "default": "#efe9d8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#f4efe4"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text",
      "default": "#d8d2c2"
    },
    {
      "type": "color",
      "id": "item_title_color",
      "label": "Item title",
      "default": "#f4efe4"
    },
    {
      "type": "color",
      "id": "item_text_color",
      "label": "Item text",
      "default": "#d6d0bf"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Vertical line",
      "default": "#f4efe4"
    }
  ],
  "blocks": [
    {
      "type": "principle",
      "name": "Principle",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Original Compositions"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "No generic formulas or mass-market copies. Each fragrance is created from scratch."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perito Story Philosophy",
      "blocks": [
        {
          "type": "principle",
          "settings": {
            "title": "Original Compositions",
            "text": "No generic formulas or mass-market copies. Each fragrance is created from scratch."
          }
        },
        {
          "type": "principle",
          "settings": {
            "title": "Material Integrity",
            "text": "We prioritize quality over cost, sourcing rare naturals and precision molecules."
          }
        },
        {
          "type": "principle",
          "settings": {
            "title": "Cultural Honesty",
            "text": "We draw from Indian traditions without appropriation or exoticization."
          }
        }
      ]
    }
  ]
}
{% endschema %}