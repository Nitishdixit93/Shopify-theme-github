  <style>
    html.perito-loading,
    html.perito-loading body {
      overflow: hidden;
    }

    .perito-loader {
      position: fixed;
      inset: 0;
      z-index: 999999;
      width: 100vw;
      height: 100dvh;
      background: #283416;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.55s ease, visibility 0.55s ease;
    }

    .perito-loader.is-hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .perito-loader__content {
      text-align: center;
      transform: translateY(-2vh);
    }

    .perito-loader__logo {
      display: block;
      margin: 0 0 58px;
    }

    .perito-loader__logo svg {
      width: clamp(260px, 40vw, 520px);
      height: auto;
    }

    .perito-loader__dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 24px;
      margin-bottom: 54px;
    }

    .perito-loader__dots .dot {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      display: block;
      animation: peritoDot 1.2s ease-in-out infinite;
    }

    .perito-loader__dots .dark {
      background: #1c1c1c;
    }

    .perito-loader__dots .light {
      background: #fff9e1;
    }

    .perito-loader__dots .dot:nth-child(1) { animation-delay: 0s; }
    .perito-loader__dots .dot:nth-child(2) { animation-delay: 0.12s; }
    .perito-loader__dots .dot:nth-child(3) { animation-delay: 0.24s; }
    .perito-loader__dots .dot:nth-child(4) { animation-delay: 0.36s; }
    .perito-loader__dots .dot:nth-child(5) { animation-delay: 0.48s; }
    .perito-loader__dots .dot:nth-child(6) { animation-delay: 0.60s; }

    @keyframes peritoDot {
      0%, 100% {
        transform: translateY(0);
        opacity: 0.65;
      }
      50% {
        transform: translateY(-12px);
        opacity: 1;
      }
    }

    .perito-loader p {
      margin: 0;
      color: #fff9e1;
      font-family: var(--font-paragraph--family, sans-serif);
      font-size: clamp(28px, 3vw, 42px);
      font-weight: 600;
      line-height: 1;
    }

    @media screen and (max-width: 749px) {
      .perito-loader__logo {
        margin-bottom: 42px;
      }

      .perito-loader__logo svg {
        width: clamp(200px, 80vw, 340px);
      }

      .perito-loader__dots {
        gap: 14px;
        margin-bottom: 38px;
      }

      .perito-loader__dots .dot {
        width: 14px;
        height: 14px;
      }
    }
  </style>

  <script>
    (function () {
      var html = document.documentElement;
      var loader = document.getElementById('PeritoLoader');

      if (!loader) return;

      html.classList.add('perito-loading');

      function hideLoader() {
        loader.classList.add('is-hidden');
        html.classList.remove('perito-loading');

        setTimeout(function () {
          if (loader && loader.parentNode) {
            loader.parentNode.removeChild(loader);
          }
        }, 700);
      }

      var duration = parseInt(loader.dataset.duration || '1600', 10);

      window.addEventListener('load', function () {
        setTimeout(hideLoader, duration);
      });

      setTimeout(hideLoader, 5000);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Perito loading screen",
  "settings": [
    {
      "type": "select",
      "id": "display_mode",
      "label": "Show loading screen",
      "options": [
        { "value": "every_page", "label": "Every page" },
        { "value": "home_only", "label": "Homepage only" },
        { "value": "disabled", "label": "Disabled" }
      ],
      "default": "home_only"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Extra loading duration",
      "min": 0,
      "max": 3000,
      "step": 100,
      "unit": "ms",
      "default": 1200
    }
  ],
  "presets": [
    {
      "name": "Perito loading screen"
    }
  ]
}
{% endschema %}