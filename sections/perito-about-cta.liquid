{% style %}
.perito-experience-craft-{{ section.id }} {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  text-align: center;
  padding: {{ section.settings.padding_top }}px {{ section.settings.padding_sides }}px {{ section.settings.padding_bottom }}px;
}

.perito-experience-craft-{{ section.id }} .perito-experience-craft__inner {
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
}

.perito-experience-craft-{{ section.id }} .perito-experience-craft__heading {
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  font-weight: {{ section.settings.heading_weight }};
  line-height: 1.2;
  margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
}

.perito-experience-craft-{{ section.id }} .perito-experience-craft__text {
  color: {{ section.settings.description_color }};
  font-size: {{ section.settings.description_size }}px;
  font-weight: {{ section.settings.description_weight }};
  line-height: {{ section.settings.description_line_height }};
  max-width: {{ section.settings.description_width }}px;
  margin: 0 auto {{ section.settings.description_margin_bottom }}px;
}

.perito-experience-craft-{{ section.id }} .perito-experience-craft__buttons {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: {{ section.settings.button_gap }}px;
  flex-wrap: wrap;
}

.perito-experience-craft-{{ section.id }} .perito-experience-craft__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: {{ section.settings.button_min_width }}px;
  min-height: {{ section.settings.button_height }}px;
  padding: 0 {{ section.settings.button_padding_sides }}px;
  font-size: {{ section.settings.button_font_size }}px;
  font-weight: {{ section.settings.button_font_weight }};
  line-height: 1;
  letter-spacing: {{ section.settings.button_letter_spacing }}px;
  text-decoration: none;
  text-transform: uppercase;
  transition: opacity 0.25s ease;
}

.perito-experience-craft-{{ section.id }} .perito-experience-craft__button:hover {
  opacity: 0.82;
}

.perito-experience-craft-{{ section.id }} .perito-experience-craft__button--primary {
  background-color: {{ section.settings.primary_button_bg }};
  color: {{ section.settings.primary_button_text }};
  border: {{ section.settings.button_border_width }}px solid {{ section.settings.primary_button_border }};
}

.perito-experience-craft-{{ section.id }} .perito-experience-craft__button--secondary {
  background-color: transparent;
  color: {{ section.settings.secondary_button_text }};
  border: {{ section.settings.button_border_width }}px solid {{ section.settings.secondary_button_border }};
}

.perito-experience-craft-{{ section.id }} .perito-experience-craft__arrow {
  margin-left: {{ section.settings.arrow_gap }}px;
  font-size: {{ section.settings.arrow_size }}px;
  line-height: 1;
}

.perito-experience-craft-bottom-{{ section.id }} {
  display: {% if section.settings.show_bottom_div %}block{% else %}none{% endif %};
  height: {{ section.settings.bottom_div_height }}px;
  background-color: {{ section.settings.bottom_div_color }};
}

@media screen and (max-width: 749px) {
  .perito-experience-craft-{{ section.id }} {
    padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_sides }}px {{ section.settings.mobile_padding_bottom }}px;
  }

  .perito-experience-craft-{{ section.id }} .perito-experience-craft__heading {
    font-size: {{ section.settings.mobile_heading_size }}px;
  }

  .perito-experience-craft-{{ section.id }} .perito-experience-craft__text {
    font-size: {{ section.settings.mobile_description_size }}px;
  }

  .perito-experience-craft-{{ section.id }} .perito-experience-craft__buttons {
    gap: {{ section.settings.mobile_button_gap }}px;
  }

  .perito-experience-craft-{{ section.id }} .perito-experience-craft__button {
    width: {% if section.settings.mobile_buttons_full_width %}100%{% else %}auto{% endif %};
  }

  .perito-experience-craft-bottom-{{ section.id }} {
    height: {{ section.settings.mobile_bottom_div_height }}px;
  }
}
{% endstyle %}

<section class="perito-experience-craft-{{ section.id }}">
  <div class="perito-experience-craft__inner">
    {% if section.settings.heading != blank %}
      <h2 class="perito-experience-craft__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="perito-experience-craft__text">
        {{ section.settings.description }}
      </p>
    {% endif %}

    <div class="perito-experience-craft__buttons">
      {% if section.settings.primary_button_label != blank %}
        <a class="perito-experience-craft__button perito-experience-craft__button--primary" href="{{ section.settings.primary_button_link }}">
          {{ section.settings.primary_button_label }}

          {% if section.settings.show_primary_arrow %}
            <span class="perito-experience-craft__arrow">
              →
            </span>
          {% endif %}
        </a>
      {% endif %}

      {% if section.settings.secondary_button_label != blank %}
        <a class="perito-experience-craft__button perito-experience-craft__button--secondary" href="{{ section.settings.secondary_button_link }}">
          {{ section.settings.secondary_button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<div class="perito-experience-craft-bottom-{{ section.id }}"></div>

