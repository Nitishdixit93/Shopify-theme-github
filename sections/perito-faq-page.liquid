{% style %}
.perito-faq-page-{{ section.id }} {
  background-color: {{ section.settings.page_bg_color }};
  color: {{ section.settings.text_color }};
}

.perito-faq-page-{{ section.id }} .perito-faq-page__hero {
  position: relative;
  min-height: {{ section.settings.hero_height }}px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: {{ section.settings.hero_padding_top }}px {{ section.settings.padding_sides }}px {{ section.settings.hero_padding_bottom }}px;
  overflow: hidden;
}

.perito-faq-page-{{ section.id }} .perito-faq-page__hero-image {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.perito-faq-page-{{ section.id }} .perito-faq-page__hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.perito-faq-page-{{ section.id }} .perito-faq-page__hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  background-color: {{ section.settings.hero_overlay_color }};
  opacity: {{ section.settings.hero_overlay_opacity | divided_by: 100.0 }};
}

.perito-faq-page-{{ section.id }} .perito-faq-page__hero-content {
  position: relative;
  z-index: 3;
  max-width: {{ section.settings.hero_content_width }}px;
  margin: 0 auto;
}

.perito-faq-page-{{ section.id }} .perito-faq-page__hero-heading {
  color: {{ section.settings.hero_heading_color }};
  font-size: {{ section.settings.hero_heading_size }}px;
  font-weight: {{ section.settings.hero_heading_weight }};
  line-height: 1.2;
  letter-spacing: {{ section.settings.hero_heading_letter_spacing }}px;
  margin: 0 0 {{ section.settings.hero_heading_margin_bottom }}px;
}

.perito-faq-page-{{ section.id }} .perito-faq-page__hero-text {
  color: {{ section.settings.hero_text_color }};
  font-size: {{ section.settings.hero_text_size }}px;
  font-weight: {{ section.settings.hero_text_weight }};
  line-height: {{ section.settings.hero_text_line_height }};
  max-width: {{ section.settings.hero_text_width }}px;
  margin: 0 auto;
}

.perito-faq-page-{{ section.id }} .perito-faq-page__main {
  padding: {{ section.settings.main_padding_top }}px {{ section.settings.padding_sides }}px {{ section.settings.main_padding_bottom }}px;
}

.perito-faq-page-{{ section.id }} .perito-faq-page__accordion {
  max-width: {{ section.settings.accordion_width }}px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: {{ section.settings.item_gap }}px;
}

.perito-faq-page-{{ section.id }} .perito-faq-page__item {
  background-color: {{ section.settings.item_bg_color }};
  border: {{ section.settings.item_border_width }}px solid {{ section.settings.item_border_color }};
  border-radius: {{ section.settings.item_radius }}px;
  overflow: hidden;
}

.perito-faq-page-{{ section.id }} .perito-faq-page__summary {
  list-style: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  color: {{ section.settings.question_color }};
  font-size: {{ section.settings.question_size }}px;
  font-weight: {{ section.settings.question_weight }};
  line-height: 1.4;
  padding: {{ section.settings.item_padding_top }}px {{ section.settings.item_padding_sides }}px {{ section.settings.item_padding_bottom }}px;
}

.perito-faq-page-{{ section.id }} .perito-faq-page__summary::-webkit-details-marker {
  display: none;
}

.perito-faq-page-{{ section.id }} .perito-faq-page__icon {
  width: {{ section.settings.icon_size }}px;
  height: {{ section.settings.icon_size }}px;
  flex: 0 0 {{ section.settings.icon_size }}px;
  color: {{ section.settings.icon_color }};
  transition: transform 0.25s ease;
}

.perito-faq-page-{{ section.id }} details[open] .perito-faq-page__icon {
  transform: rotate(180deg);
}

.perito-faq-page-{{ section.id }} .perito-faq-page__answer {
  color: {{ section.settings.answer_color }};
  font-size: {{ section.settings.answer_size }}px;
  font-weight: {{ section.settings.answer_weight }};
  line-height: {{ section.settings.answer_line_height }};
  padding: 0 {{ section.settings.item_padding_sides }}px {{ section.settings.answer_padding_bottom }}px;
}

@media screen and (max-width: 749px) {
  .perito-faq-page-{{ section.id }} .perito-faq-page__hero {
    min-height: {{ section.settings.mobile_hero_height }}px;
    padding: {{ section.settings.mobile_hero_padding_top }}px {{ section.settings.mobile_padding_sides }}px {{ section.settings.mobile_hero_padding_bottom }}px;
  }

  .perito-faq-page-{{ section.id }} .perito-faq-page__hero-heading {
    font-size: {{ section.settings.mobile_hero_heading_size }}px;
  }

  .perito-faq-page-{{ section.id }} .perito-faq-page__hero-text {
    font-size: {{ section.settings.mobile_hero_text_size }}px;
  }

  .perito-faq-page-{{ section.id }} .perito-faq-page__main {
    padding: {{ section.settings.mobile_main_padding_top }}px {{ section.settings.mobile_padding_sides }}px {{ section.settings.mobile_main_padding_bottom }}px;
  }

  .perito-faq-page-{{ section.id }} .perito-faq-page__accordion {
    gap: {{ section.settings.mobile_item_gap }}px;
  }

  .perito-faq-page-{{ section.id }} .perito-faq-page__summary {
    font-size: {{ section.settings.mobile_question_size }}px;
    padding: {{ section.settings.mobile_item_padding_top }}px {{ section.settings.mobile_item_padding_sides }}px {{ section.settings.mobile_item_padding_bottom }}px;
  }

  .perito-faq-page-{{ section.id }} .perito-faq-page__answer {
    font-size: {{ section.settings.mobile_answer_size }}px;
    padding: 0 {{ section.settings.mobile_item_padding_sides }}px {{ section.settings.mobile_answer_padding_bottom }}px;
  }
}
{% endstyle %}

<section class="perito-faq-page-{{ section.id }}">
  {% if section.settings.show_hero %}
    <div class="perito-faq-page__hero">
      {% if section.settings.hero_image != blank %}
        <div class="perito-faq-page__hero-image">
          {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager' }}
        </div>
      {% endif %}

      <div class="perito-faq-page__hero-overlay"></div>

      <div class="perito-faq-page__hero-content">
        {% if section.settings.hero_heading != blank %}
          <h1 class="perito-faq-page__hero-heading">
            {{ section.settings.hero_heading }}
          </h1>
        {% endif %}

        {% if section.settings.hero_text != blank %}
          <p class="perito-faq-page__hero-text">
            {{ section.settings.hero_text }}
          </p>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="perito-faq-page__main">
    <div class="perito-faq-page__accordion">
      {% for block in section.blocks %}
        <details class="perito-faq-page__item" {% if section.settings.open_first_item and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="perito-faq-page__summary">
            <span>
              {{ block.settings.question }}
            </span>

            <svg class="perito-faq-page__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none">
              <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>

          {% if block.settings.answer != blank %}
            <div class="perito-faq-page__answer">
              {{ block.settings.answer | newline_to_br }}
            </div>
          {% endif %}
        </details>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function () {
    function initFaqAccordion() {
      var faqSection = document.querySelector('.perito-faq-page-{{ section.id }}');

      if (!faqSection) return;

      var faqItems = faqSection.querySelectorAll('.perito-faq-page__item');

      faqItems.forEach(function (item) {
        item.addEventListener('toggle', function () {
          if (!item.open) return;

          faqItems.forEach(function (otherItem) {
            if (otherItem !== item) {
              otherItem.removeAttribute('open');
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFaqAccordion);
    } else {
      initFaqAccordion();
    }

    document.addEventListener('shopify:section:load', initFaqAccordion);
  })();
</script>

