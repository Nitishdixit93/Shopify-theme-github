{% style %}
  .perito-story-values {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text_color }};
    text-align: center;
  }

  .perito-story-values__inner {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding:
      {{ section.settings.padding_top }}px
      {{ section.settings.padding_x }}px
      {{ section.settings.padding_bottom }}px;
  }

  .perito-story-values__heading {
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.1;
    font-weight: 500;
  }

  .perito-story-values__text {
    margin: 0 auto;
    max-width: {{ section.settings.text_width }}px;
    color: {{ section.settings.body_color }};
    font-size: {{ section.settings.body_size }}px;
    line-height: {{ section.settings.body_line_height }};
    font-weight: 300;
  }

  .perito-story-values__text p {
    margin: 0 0 {{ section.settings.paragraph_gap }}px;
  }

  .perito-story-values__text p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .perito-story-values__inner {
      padding:
        {{ section.settings.mobile_padding_top }}px
        {{ section.settings.mobile_padding_x }}px
        {{ section.settings.mobile_padding_bottom }}px;
    }

    .perito-story-values__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    .perito-story-values__text {
      font-size: {{ section.settings.mobile_body_size }}px;
    }
  }
{% endstyle %}

<section class="perito-story-values">
  <div class="perito-story-values__inner">
    {% if section.settings.heading != blank %}
      <h2 class="perito-story-values__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="perito-story-values__text">
        {{ section.settings.text }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Perito Story Values",
  "tag": "section",
  "class": "section-perito-story-values",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What We Stand For"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Transparency over marketing language. Quality over quantity. Craft over convenience. We build fragrances for people who care about what they wear and why.</p><p>Perito Moreno is for collectors, enthusiasts, and anyone who believes that fragrance should be treated as an art form—not a commodity.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "default": 1120,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Text width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "default": 920,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 60,
      "max": 220,
      "step": 4,
      "default": 136,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 60,
      "max": 220,
      "step": 4,
      "default": 144,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Side padding",
      "min": 16,
      "max": 80,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading bottom spacing",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 46,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "paragraph_gap",
      "label": "Paragraph gap",
      "min": 18,
      "max": 70,
      "step": 2,
      "default": 46,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 32,
      "max": 72,
      "step": 1,
      "default": 52,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 14,
      "max": 28,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_line_height",
      "label": "Body line height",
      "min": 1.3,
      "max": 2.2,
      "step": 0.1,
      "default": 1.7
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 40,
      "max": 140,
      "step": 2,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 40,
      "max": 140,
      "step": 2,
      "default": 78,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_x",
      "label": "Mobile side padding",
      "min": 16,
      "max": 40,
      "step": 2,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 28,
      "max": 50,
      "step": 1,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_body_size",
      "label": "Mobile body size",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#637236"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base text",
      "default": "#efe9d8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#f4efe4"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text",
      "default": "#d8d2c2"
    }
  ],
  "presets": [
    {
      "name": "Perito Story Values"
    }
  ]
}
{% endschema %}