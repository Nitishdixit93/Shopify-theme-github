{% style %}
.perito-past-products-{{ section.id }} {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_top }}px {{ section.settings.padding_sides }}px {{ section.settings.padding_bottom }}px;
}

.perito-past-products-{{ section.id }} .perito-past-products__inner {
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
}

.perito-past-products-{{ section.id }} .perito-past-products__header {
  max-width: {{ section.settings.header_width }}px;
  margin: 0 auto {{ section.settings.header_margin_bottom }}px;
  text-align: center;
}

.perito-past-products-{{ section.id }} .perito-past-products__eyebrow {
  color: {{ section.settings.eyebrow_color }};
  font-size: {{ section.settings.eyebrow_size }}px;
  font-weight: {{ section.settings.eyebrow_weight }};
  line-height: 1.3;
  letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
  text-transform: uppercase;
  margin: 0 0 {{ section.settings.eyebrow_margin_bottom }}px;
}

.perito-past-products-{{ section.id }} .perito-past-products__heading {
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  font-weight: {{ section.settings.heading_weight }};
  line-height: 1.15;
  margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
}

.perito-past-products-{{ section.id }} .perito-past-products__description {
  color: {{ section.settings.description_color }};
  font-size: {{ section.settings.description_size }}px;
  font-weight: {{ section.settings.description_weight }};
  line-height: {{ section.settings.description_line_height }};
  max-width: {{ section.settings.description_width }}px;
  margin: 0 auto;
}

.perito-past-products-{{ section.id }} .perito-past-products__grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  column-gap: {{ section.settings.column_gap }}px;
  row-gap: {{ section.settings.row_gap }}px;
}

.perito-past-products-{{ section.id }} .perito-past-products__card {
  display: block;
  color: inherit;
  text-decoration: none;
}

.perito-past-products-{{ section.id }} .perito-past-products__image-wrap {
  width: 100%;
  aspect-ratio: {{ section.settings.image_aspect_ratio }};
  background-color: {{ section.settings.image_bg_color }};
  margin-bottom: {{ section.settings.image_margin_bottom }}px;
  overflow: hidden;
}

.perito-past-products-{{ section.id }} .perito-past-products__image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.perito-past-products-{{ section.id }} .perito-past-products__placeholder {
  width: 100%;
  height: 100%;
  background-color: {{ section.settings.placeholder_bg_color }};
}

.perito-past-products-{{ section.id }} .perito-past-products__collection {
  color: {{ section.settings.collection_label_color }};
  font-size: {{ section.settings.collection_label_size }}px;
  font-weight: {{ section.settings.collection_label_weight }};
  line-height: 1.4;
  letter-spacing: {{ section.settings.collection_label_letter_spacing }}px;
  text-transform: uppercase;
  margin: 0 0 {{ section.settings.collection_label_margin_bottom }}px;
}

.perito-past-products-{{ section.id }} .perito-past-products__title {
  color: {{ section.settings.product_title_color }};
  font-size: {{ section.settings.product_title_size }}px;
  font-weight: {{ section.settings.product_title_weight }};
  line-height: 1.35;
  margin: 0 0 {{ section.settings.product_title_margin_bottom }}px;
}

.perito-past-products-{{ section.id }} .perito-past-products__date {
  color: {{ section.settings.date_color }};
  font-size: {{ section.settings.date_size }}px;
  font-weight: {{ section.settings.date_weight }};
  line-height: 1.4;
  margin: 0;
}

.perito-past-products-{{ section.id }} .perito-past-products__empty {
  color: {{ section.settings.description_color }};
  font-size: {{ section.settings.description_size }}px;
  text-align: center;
  margin: 0;
}

@media screen and (max-width: 989px) {
  .perito-past-products-{{ section.id }} .perito-past-products__grid {
    grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    column-gap: {{ section.settings.tablet_column_gap }}px;
    row-gap: {{ section.settings.tablet_row_gap }}px;
  }
}

@media screen and (max-width: 749px) {
  .perito-past-products-{{ section.id }} {
    padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_sides }}px {{ section.settings.mobile_padding_bottom }}px;
  }

  .perito-past-products-{{ section.id }} .perito-past-products__header {
    margin-bottom: {{ section.settings.mobile_header_margin_bottom }}px;
  }

  .perito-past-products-{{ section.id }} .perito-past-products__heading {
    font-size: {{ section.settings.mobile_heading_size }}px;
  }

  .perito-past-products-{{ section.id }} .perito-past-products__description {
    font-size: {{ section.settings.mobile_description_size }}px;
  }

  .perito-past-products-{{ section.id }} .perito-past-products__grid {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    row-gap: {{ section.settings.mobile_row_gap }}px;
  }
}
{% endstyle %}

<section class="perito-past-products-{{ section.id }}">
  <div class="perito-past-products__inner">
    <div class="perito-past-products__header">
      {% if section.settings.eyebrow != blank %}
        <p class="perito-past-products__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="perito-past-products__heading">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="perito-past-products__description">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    {% liquid
      assign filter_tag = 'past-product' | strip
      assign shown_products = 0

      if section.settings.product_collection != blank
        assign source_products = section.settings.product_collection.products
      else
        assign source_products = collections.all.products
      endif
    %}

    <div class="perito-past-products__grid">
      {% for product in source_products limit: section.settings.products_to_check %}
        {% liquid
          assign show_product = false

          if filter_tag == blank
            assign show_product = true
          elsif product.tags contains filter_tag
            assign show_product = true
          endif
        %}

        {% if show_product and shown_products < section.settings.product_limit %}
          {% liquid
            assign shown_products = shown_products | plus: 1

            assign collection_label = product.metafields.custom.collection_label.value
            if collection_label == blank
              assign collection_label = product.type
            endif
            if collection_label == blank and product.collections.first != blank
              assign collection_label = product.collections.first.title
            endif

            assign release_date = product.metafields.custom.release_date.value
            assign release_label = product.metafields.custom.release_label.value
            if release_label == blank and release_date != blank
              assign release_label = release_date | date: "%B %Y"
            endif
            if release_label == blank
              assign release_label = section.settings.fallback_date
            endif
          %}

          <a class="perito-past-products__card" href="{{ product.url }}">
            <div class="perito-past-products__image-wrap">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}
              {% else %}
                <div class="perito-past-products__placeholder"></div>
              {% endif %}
            </div>

            {% if collection_label != blank %}
              <p class="perito-past-products__collection">
                {{ collection_label }}
              </p>
            {% endif %}

            <h2 class="perito-past-products__title">
              {{ product.title }}
            </h2>

            {% if release_label != blank %}
              <p class="perito-past-products__date">
                {{ release_label }}
              </p>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {% if shown_products == 0 %}
      <p class="perito-past-products__empty">
        {{ section.settings.empty_text }}
      </p>
    {% endif %}
  </div>
</section>

{% schema %}
