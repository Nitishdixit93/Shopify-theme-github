{% style %}
.perito-awards-{{ section.id }} {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_top }}px {{ section.settings.padding_sides }}px {{ section.settings.padding_bottom }}px;
}

.perito-awards-{{ section.id }} .perito-awards__inner {
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
}

.perito-awards-{{ section.id }} .perito-awards__heading {
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  font-weight: {{ section.settings.heading_weight }};
  line-height: 1.2;
  text-align: center;
  margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
}

.perito-awards-{{ section.id }} .perito-awards__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: {{ section.settings.grid_row_gap }}px {{ section.settings.grid_column_gap }}px;
}

.perito-awards-{{ section.id }} .perito-awards__card {
  border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
  background-color: {{ section.settings.card_bg_color }};
  padding: {{ section.settings.card_padding_top }}px {{ section.settings.card_padding_sides }}px {{ section.settings.card_padding_bottom }}px;
  min-height: {{ section.settings.card_min_height }}px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.perito-awards-{{ section.id }} .perito-awards__year {
  color: {{ section.settings.year_color }};
  font-size: {{ section.settings.year_size }}px;
  font-weight: {{ section.settings.year_weight }};
  line-height: 1.3;
  margin: 0 0 {{ section.settings.year_margin_bottom }}px;
}

.perito-awards-{{ section.id }} .perito-awards__title {
  color: {{ section.settings.title_color }};
  font-size: {{ section.settings.title_size }}px;
  font-weight: {{ section.settings.title_weight }};
  line-height: 1.3;
  margin: 0 0 {{ section.settings.title_margin_bottom }}px;
}

.perito-awards-{{ section.id }} .perito-awards__text {
  color: {{ section.settings.description_color }};
  font-size: {{ section.settings.description_size }}px;
  font-weight: {{ section.settings.description_weight }};
  line-height: {{ section.settings.description_line_height }};
  margin: 0;
}

@media screen and (max-width: 749px) {
  .perito-awards-{{ section.id }} {
    padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_sides }}px {{ section.settings.mobile_padding_bottom }}px;
  }

  .perito-awards-{{ section.id }} .perito-awards__heading {
    font-size: {{ section.settings.mobile_heading_size }}px;
    margin-bottom: {{ section.settings.mobile_heading_margin_bottom }}px;
  }

  .perito-awards-{{ section.id }} .perito-awards__grid {
    grid-template-columns: 1fr;
    gap: {{ section.settings.mobile_grid_gap }}px;
  }

  .perito-awards-{{ section.id }} .perito-awards__card {
    padding: {{ section.settings.mobile_card_padding_top }}px {{ section.settings.mobile_card_padding_sides }}px {{ section.settings.mobile_card_padding_bottom }}px;
    min-height: {{ section.settings.mobile_card_min_height }}px;
  }

  .perito-awards-{{ section.id }} .perito-awards__title {
    font-size: {{ section.settings.mobile_title_size }}px;
  }

  .perito-awards-{{ section.id }} .perito-awards__text {
    font-size: {{ section.settings.mobile_description_size }}px;
  }
}
{% endstyle %}

<section class="perito-awards-{{ section.id }}">
  <div class="perito-awards__inner">
    {% if section.settings.heading != blank %}
      <h2 class="perito-awards__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="perito-awards__grid">
      {% for block in section.blocks %}
        <div class="perito-awards__card" {{ block.shopify_attributes }}>
          {% if block.settings.year != blank %}
            <p class="perito-awards__year">
              {{ block.settings.year }}
            </p>
          {% endif %}

          {% if block.settings.award_title != blank %}
            <h3 class="perito-awards__title">
              {{ block.settings.award_title }}
            </h3>
          {% endif %}

          {% if block.settings.award_description != blank %}
            <p class="perito-awards__text">
              {{ block.settings.award_description }}
            </p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

